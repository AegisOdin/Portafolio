---
// Three.js wireframe phosphor model rendered into a canvas.
// Drop anywhere; sizes to its parent.
const { class: className = "" } = Astro.props as { class?: string };
---

<div class={`crt-model ${className}`} aria-hidden="true">
  <canvas data-crt-canvas></canvas>
  <div class="crt-model__hud">
    <span>◉ rec</span>
    <span data-crt-fps>--</span>
    <span>fps</span>
  </div>
  <div class="crt-model__corners">
    <span></span><span></span><span></span><span></span>
  </div>
</div>

<style>
  .crt-model {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 320px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    background:
      radial-gradient(ellipse at center, color-mix(in srgb, var(--accent) 8%, transparent), transparent 70%),
      var(--color-bg-elev);
    box-shadow:
      inset 0 0 40px -10px color-mix(in srgb, var(--accent) 60%, transparent),
      0 0 22px -8px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .crt-model canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }
  .crt-model__hud {
    position: absolute;
    top: 10px;
    left: 12px;
    display: flex;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-amber);
    pointer-events: none;
    text-shadow: 0 0 6px color-mix(in srgb, var(--color-amber) 55%, transparent);
    z-index: 2;
  }
  .crt-model__corners span {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid var(--accent);
    pointer-events: none;
    opacity: 0.75;
  }
  .crt-model__corners span:nth-child(1) { top: 6px; left: 6px;  border-right: none; border-bottom: none; }
  .crt-model__corners span:nth-child(2) { top: 6px; right: 6px; border-left:  none; border-bottom: none; }
  .crt-model__corners span:nth-child(3) { bottom: 6px; left: 6px; border-right: none; border-top: none; }
  .crt-model__corners span:nth-child(4) { bottom: 6px; right: 6px; border-left: none; border-top: none; }
</style>

<script>
  import * as THREE from "three";

  const mounts = document.querySelectorAll<HTMLElement>(".crt-model");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const phosphorHex = () => {
    const v = getComputedStyle(document.documentElement)
      .getPropertyValue("--color-phosphor")
      .trim() || "#39ff14";
    return new THREE.Color(v);
  };
  const amberHex = () => {
    const v = getComputedStyle(document.documentElement)
      .getPropertyValue("--color-amber")
      .trim() || "#ffb000";
    return new THREE.Color(v);
  };

  mounts.forEach((mount) => {
    const canvas = mount.querySelector<HTMLCanvasElement>("[data-crt-canvas]");
    const fpsEl = mount.querySelector<HTMLElement>("[data-crt-fps]");
    if (!canvas) return;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: "low-power",
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
    camera.position.set(0, 0, 4.2);

    const phosphor = phosphorHex();
    const amber = amberHex();

    // Core wireframe icosahedron
    const coreGeo = new THREE.IcosahedronGeometry(1.2, 1);
    const coreMat = new THREE.MeshBasicMaterial({
      color: phosphor,
      wireframe: true,
      transparent: true,
      opacity: 0.9,
    });
    const core = new THREE.Mesh(coreGeo, coreMat);
    scene.add(core);

    // Inner solid (faint) for depth
    const innerGeo = new THREE.IcosahedronGeometry(0.85, 0);
    const innerMat = new THREE.MeshBasicMaterial({
      color: phosphor,
      transparent: true,
      opacity: 0.06,
      side: THREE.DoubleSide,
    });
    const inner = new THREE.Mesh(innerGeo, innerMat);
    scene.add(inner);

    // Outer ring shell — torus rotating on axis
    const ringGeo = new THREE.TorusGeometry(1.9, 0.005, 6, 96);
    const ringMat = new THREE.MeshBasicMaterial({ color: amber, transparent: true, opacity: 0.8 });
    const ring1 = new THREE.Mesh(ringGeo, ringMat);
    const ring2 = new THREE.Mesh(ringGeo, ringMat.clone());
    ring2.rotation.x = Math.PI / 2;
    const ring3 = new THREE.Mesh(ringGeo, ringMat.clone());
    ring3.rotation.y = Math.PI / 2;
    scene.add(ring1, ring2, ring3);

    // Particle starfield
    const pCount = 600;
    const positions = new Float32Array(pCount * 3);
    for (let i = 0; i < pCount; i++) {
      const r = 6 + Math.random() * 10;
      const t = Math.random() * Math.PI * 2;
      const p = Math.acos(2 * Math.random() - 1);
      positions[i * 3]     = r * Math.sin(p) * Math.cos(t);
      positions[i * 3 + 1] = r * Math.sin(p) * Math.sin(t);
      positions[i * 3 + 2] = r * Math.cos(p);
    }
    const pGeo = new THREE.BufferGeometry();
    pGeo.setAttribute("position", new THREE.BufferAttribute(positions, 3));
    const pMat = new THREE.PointsMaterial({
      color: phosphor,
      size: 0.035,
      sizeAttenuation: true,
      transparent: true,
      opacity: 0.65,
    });
    const particles = new THREE.Points(pGeo, pMat);
    scene.add(particles);

    // Resize handling
    const resize = () => {
      const w = mount.clientWidth;
      const h = mount.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    };
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(mount);

    // Pointer parallax
    const target = { x: 0, y: 0 };
    const onMove = (e: PointerEvent) => {
      const r = mount.getBoundingClientRect();
      target.x = ((e.clientX - r.left) / r.width - 0.5) * 0.8;
      target.y = ((e.clientY - r.top) / r.height - 0.5) * 0.8;
    };
    mount.addEventListener("pointermove", onMove);
    mount.addEventListener("pointerleave", () => { target.x = 0; target.y = 0; });

    // Pause when offscreen
    let visible = true;
    const io = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }, { threshold: 0 });
    io.observe(mount);

    let raf = 0;
    let last = performance.now();
    let fpsAccum = 0, fpsFrames = 0, fpsTimer = 0;

    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      if (!visible) return;

      const speed = reduced ? 0.05 : 1;
      core.rotation.x += dt * 0.35 * speed;
      core.rotation.y += dt * 0.5 * speed;
      inner.rotation.x -= dt * 0.2 * speed;
      inner.rotation.y -= dt * 0.3 * speed;
      ring1.rotation.z += dt * 0.4 * speed;
      ring2.rotation.z -= dt * 0.25 * speed;
      ring3.rotation.x += dt * 0.3 * speed;
      particles.rotation.y += dt * 0.04 * speed;

      // Parallax
      camera.position.x += (target.x * 1.2 - camera.position.x) * 0.05;
      camera.position.y += (-target.y * 1.2 - camera.position.y) * 0.05;
      camera.lookAt(0, 0, 0);

      // Subtle scale pulse — phosphor breath
      const s = 1 + Math.sin(now * 0.002) * 0.02;
      core.scale.setScalar(s);

      renderer.render(scene, camera);

      // fps counter
      fpsTimer += dt; fpsFrames++; fpsAccum += 1 / dt;
      if (fpsTimer >= 0.5) {
        if (fpsEl) fpsEl.textContent = String(Math.round(fpsAccum / fpsFrames));
        fpsTimer = 0; fpsAccum = 0; fpsFrames = 0;
      }
    };
    raf = requestAnimationFrame(loop);

    window.addEventListener("beforeunload", () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      io.disconnect();
      renderer.dispose();
      coreGeo.dispose(); coreMat.dispose();
      innerGeo.dispose(); innerMat.dispose();
      ringGeo.dispose(); ringMat.dispose();
      pGeo.dispose(); pMat.dispose();
    });
  });
</script>
