<div class="scroll-atmosphere" aria-hidden="true">
  <div class="depth-grid"></div>
  <div class="depth-orbit"></div>
</div>

<style>
  .scroll-atmosphere { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .depth-grid { position: absolute; inset: -25%; background-image: linear-gradient(color-mix(in srgb, var(--accent) 4%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--accent) 4%, transparent) 1px, transparent 1px); background-size: 7rem 7rem; transform: translate3d(0, var(--depth-drift, 0px), 0) rotate(-12deg); mask-image: linear-gradient(90deg, black, transparent 42%, transparent 65%, black); }
  .depth-orbit { position: absolute; top: 30%; right: -17rem; width: 40rem; height: 40rem; border: 1px solid color-mix(in srgb, var(--accent) 10%, transparent); border-radius: 50%; transform: translate3d(0, var(--orbit-drift, 0px), 0) rotateX(50deg) rotateZ(-30deg); box-shadow: 0 0 0 3rem color-mix(in srgb, var(--accent) 2%, transparent), 0 0 0 6rem color-mix(in srgb, var(--accent) 2%, transparent); }
  @media (max-width: 767px) { .depth-orbit { display: none; } .depth-grid { opacity: 0.6; } }
  @media (prefers-reduced-motion: reduce) { .depth-grid, .depth-orbit { transform: none; } }
  @media print { .scroll-atmosphere { display: none; } }
</style>

<script>
  const atmosphere = document.querySelector<HTMLElement>(".scroll-atmosphere");
  if (atmosphere) {
    const root = document.documentElement;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const mobile = matchMedia("(max-width: 767px), (pointer: coarse)");
    const header = document.querySelector<HTMLElement>(".site-header");
    const sections = Array.from(document.querySelectorAll<HTMLElement>("main > section"));
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".site-header nav a[href^='#']"));
    let frame = 0;
    let activeId = "";
    let geometryDirty = true;
    let range = 1;
    let sectionTops: number[] = [];

    function renderDepth() {
      frame = 0;
      if (document.hidden) return;
      // Measure before writing styles; cache document coordinates between resizes.
      if (geometryDirty) {
        range = Math.max(1, root.scrollHeight - innerHeight);
        sectionTops = sections.map((section) => {
          // Layout offsets exclude the temporary translateY used by section reveals.
          let top = 0;
          let element: HTMLElement | null = section;
          while (element) {
            top += element.offsetTop;
            element = element.offsetParent as HTMLElement | null;
          }
          return top;
        });
        geometryDirty = false;
      }
      const progress = Math.min(1, Math.max(0, scrollY / range));
      let current = sections[0]?.id ?? "";
      sectionTops.forEach((top, index) => {
        if (top <= scrollY + innerHeight * 0.4) current = sections[index].id;
      });
      if (progress > 0.99) current = sections.at(-1)?.id ?? current;
      header?.style.setProperty("--scroll-progress", String(progress));
      if (!mobile.matches && !reduced.matches) {
        atmosphere!.style.setProperty("--depth-drift", `${-progress * 260}px`);
        atmosphere!.style.setProperty("--orbit-drift", `${-progress * 450}px`);
      }
      if (activeId === current) return;
      activeId = current;
      links.forEach((link) => {
        if (link.hash === `#${current}`) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    }

    function scheduleDepth() {
      if (!frame && !document.hidden) frame = requestAnimationFrame(renderDepth);
    }
    function invalidateGeometry() {
      geometryDirty = true;
      scheduleDepth();
    }
    function resetDepth() {
      atmosphere!.style.removeProperty("--depth-drift");
      atmosphere!.style.removeProperty("--orbit-drift");
      invalidateGeometry();
    }
    addEventListener("scroll", scheduleDepth, { passive: true });
    addEventListener("resize", invalidateGeometry, { passive: true });
    document.addEventListener("visibilitychange", invalidateGeometry);
    reduced.addEventListener("change", resetDepth);
    mobile.addEventListener("change", resetDepth);
    const resizeObserver = new ResizeObserver(invalidateGeometry);
    resizeObserver.observe(document.body);
    sections.forEach((section) => resizeObserver.observe(section));
    scheduleDepth();
  }
</script>
