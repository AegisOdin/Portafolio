---
// Three.js scene rendered into a canvas.
// Two looks, swapped live by data-theme:
//   - default ........... phosphor icosahedron + amber rings + starfield
//   - realworld ......... cold wireframe sentinel + red eye + dust drift
// Drop anywhere; sizes to its parent.
const { class: className = "" } = Astro.props as { class?: string };
---

<div class={`crt-model ${className}`} aria-hidden="true">
  <canvas data-crt-canvas></canvas>
  <div class="crt-model__hud">
    <span data-crt-hud-rec>◉ rec</span>
    <span data-crt-fps>--</span>
    <span>fps</span>
  </div>
  <div class="crt-model__corners">
    <span></span><span></span><span></span><span></span>
  </div>
</div>

<style>
  .crt-model {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    background:
      radial-gradient(ellipse at center, color-mix(in srgb, var(--accent) 8%, transparent), transparent 70%),
      var(--color-bg-elev);
    box-shadow:
      inset 0 0 40px -10px color-mix(in srgb, var(--accent) 60%, transparent),
      0 0 22px -8px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  /* In realworld: kill the warm phosphor halo, go cold steel */
  :root[data-theme="realworld"] .crt-model {
    border-color: #2a3942;
    background:
      radial-gradient(ellipse at center, rgba(120, 140, 150, 0.06), transparent 70%),
      #0a1015;
    box-shadow:
      inset 0 0 60px -10px rgba(0, 0, 0, 0.85),
      0 1px 0 rgba(255, 255, 255, 0.02);
  }
  .crt-model canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }
  .crt-model__hud {
    position: absolute;
    top: 10px;
    left: 12px;
    display: flex;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-amber);
    pointer-events: none;
    text-shadow: 0 0 6px color-mix(in srgb, var(--color-amber) 55%, transparent);
    z-index: 2;
  }
  :root[data-theme="realworld"] .crt-model__hud {
    color: #c43a3a;
    text-shadow: 0 0 4px rgba(196, 58, 58, 0.4);
    letter-spacing: 0.22em;
  }
  .crt-model__corners span {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid var(--accent);
    pointer-events: none;
    opacity: 0.75;
  }
  :root[data-theme="realworld"] .crt-model__corners span {
    border-color: #485862;
    opacity: 0.5;
  }
  .crt-model__corners span:nth-child(1) { top: 6px; left: 6px;  border-right: none; border-bottom: none; }
  .crt-model__corners span:nth-child(2) { top: 6px; right: 6px; border-left:  none; border-bottom: none; }
  .crt-model__corners span:nth-child(3) { bottom: 6px; left: 6px; border-right: none; border-top: none; }
  .crt-model__corners span:nth-child(4) { bottom: 6px; right: 6px; border-left: none; border-top: none; }
</style>

<script>
  import * as THREE from "three";

  type Disposable = { dispose(): void };
  type SceneBundle = {
    update: (dt: number, now: number) => void;
    dispose: () => void;
  };

  const mounts = document.querySelectorAll<HTMLElement>(".crt-model");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const cssColor = (varName: string, fallback: string) => {
    const v = getComputedStyle(document.documentElement)
      .getPropertyValue(varName)
      .trim() || fallback;
    return new THREE.Color(v);
  };

  const isRealWorld = () =>
    document.documentElement.getAttribute("data-theme") === "realworld";

  mounts.forEach((mount) => {
    const canvas = mount.querySelector<HTMLCanvasElement>("[data-crt-canvas]");
    const fpsEl = mount.querySelector<HTMLElement>("[data-crt-fps]");
    const hudRecEl = mount.querySelector<HTMLElement>("[data-crt-hud-rec]");
    if (!canvas) return;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: "low-power",
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
    camera.position.set(0, 0, 4.2);

    // ---------------- Sim scene (phosphor / default) ----------------
    function buildSim(): SceneBundle {
      const phosphor = cssColor("--color-phosphor", "#39ff14");
      const amber = cssColor("--color-amber", "#ffb000");

      const coreGeo = new THREE.IcosahedronGeometry(1.2, 1);
      const coreMat = new THREE.MeshBasicMaterial({
        color: phosphor, wireframe: true, transparent: true, opacity: 0.9,
      });
      const core = new THREE.Mesh(coreGeo, coreMat);

      const innerGeo = new THREE.IcosahedronGeometry(0.85, 0);
      const innerMat = new THREE.MeshBasicMaterial({
        color: phosphor, transparent: true, opacity: 0.06, side: THREE.DoubleSide,
      });
      const inner = new THREE.Mesh(innerGeo, innerMat);

      const ringGeo = new THREE.TorusGeometry(1.9, 0.005, 6, 96);
      const ringMatA = new THREE.MeshBasicMaterial({ color: amber, transparent: true, opacity: 0.8 });
      const ringMatB = ringMatA.clone();
      const ringMatC = ringMatA.clone();
      const ring1 = new THREE.Mesh(ringGeo, ringMatA);
      const ring2 = new THREE.Mesh(ringGeo, ringMatB);
      ring2.rotation.x = Math.PI / 2;
      const ring3 = new THREE.Mesh(ringGeo, ringMatC);
      ring3.rotation.y = Math.PI / 2;

      const pCount = 600;
      const positions = new Float32Array(pCount * 3);
      for (let i = 0; i < pCount; i++) {
        const r = 6 + Math.random() * 10;
        const t = Math.random() * Math.PI * 2;
        const p = Math.acos(2 * Math.random() - 1);
        positions[i * 3]     = r * Math.sin(p) * Math.cos(t);
        positions[i * 3 + 1] = r * Math.sin(p) * Math.sin(t);
        positions[i * 3 + 2] = r * Math.cos(p);
      }
      const pGeo = new THREE.BufferGeometry();
      pGeo.setAttribute("position", new THREE.BufferAttribute(positions, 3));
      const pMat = new THREE.PointsMaterial({
        color: phosphor, size: 0.035, sizeAttenuation: true, transparent: true, opacity: 0.65,
      });
      const particles = new THREE.Points(pGeo, pMat);

      scene.add(core, inner, ring1, ring2, ring3, particles);
      scene.background = null;

      const disposables: Disposable[] = [
        coreGeo, coreMat, innerGeo, innerMat,
        ringGeo, ringMatA, ringMatB, ringMatC,
        pGeo, pMat,
      ];
      const meshes = [core, inner, ring1, ring2, ring3, particles];

      return {
        update(dt, now) {
          const speed = reduced ? 0.05 : 1;
          core.rotation.x += dt * 0.35 * speed;
          core.rotation.y += dt * 0.5  * speed;
          inner.rotation.x -= dt * 0.2  * speed;
          inner.rotation.y -= dt * 0.3  * speed;
          ring1.rotation.z += dt * 0.4  * speed;
          ring2.rotation.z -= dt * 0.25 * speed;
          ring3.rotation.x += dt * 0.3  * speed;
          particles.rotation.y += dt * 0.04 * speed;
          const s = 1 + Math.sin(now * 0.002) * 0.02;
          core.scale.setScalar(s);
        },
        dispose() {
          meshes.forEach((m) => scene.remove(m));
          disposables.forEach((d) => d.dispose());
        },
      };
    }

    // ---------------- Realworld scene (sentinel) ----------------
    // Wireframe machine body + 8 tentacle tubes + single red eye + cold dust.
    function buildReal(): SceneBundle {
      const steel  = new THREE.Color("#7a8a92");
      const dim    = new THREE.Color("#485862");
      const danger = new THREE.Color("#c43a3a");

      // Sentinel body — distorted dodecahedron, mechanical
      const bodyGeo = new THREE.DodecahedronGeometry(0.62, 0);
      const bodyWireMat = new THREE.MeshBasicMaterial({
        color: steel, wireframe: true, transparent: true, opacity: 0.85,
      });
      const body = new THREE.Mesh(bodyGeo, bodyWireMat);

      // Inner dim shell — hint of mass
      const hullGeo = new THREE.IcosahedronGeometry(0.45, 0);
      const hullMat = new THREE.MeshBasicMaterial({
        color: dim, transparent: true, opacity: 0.18, side: THREE.DoubleSide,
      });
      const hull = new THREE.Mesh(hullGeo, hullMat);
      body.add(hull);

      // Tentacles — TubeGeometry along curved paths emanating from body
      const TENT = 8;
      const tentacleGeos: THREE.BufferGeometry[] = [];
      const tentacleMats: THREE.Material[] = [];
      const tentacleMeshes: THREE.Mesh[] = [];
      const tentacleSeeds: number[] = [];
      for (let i = 0; i < TENT; i++) {
        const angle = (i / TENT) * Math.PI * 2;
        const tilt  = (i % 2 === 0 ? 0.5 : -0.45) + (Math.random() - 0.5) * 0.4;
        const seed  = Math.random() * Math.PI * 2;
        const points: THREE.Vector3[] = [];
        const segs = 14;
        for (let s = 0; s <= segs; s++) {
          const t = s / segs;
          const r = 0.55 + t * 1.7;
          const swing = Math.sin(t * Math.PI * 2 + seed) * 0.18 * t;
          const droop = -t * t * 0.4 * (i % 2 === 0 ? 1 : -1);
          points.push(new THREE.Vector3(
            Math.cos(angle) * r + swing * Math.cos(angle + Math.PI / 2),
            Math.sin(angle) * r * tilt + droop,
            Math.sin(angle) * r + swing * Math.sin(angle + Math.PI / 2),
          ));
        }
        const curve = new THREE.CatmullRomCurve3(points);
        const tubeGeo = new THREE.TubeGeometry(curve, 28, 0.011, 5, false);
        const tubeMat = new THREE.MeshBasicMaterial({
          color: steel, transparent: true, opacity: 0.55,
        });
        const tube = new THREE.Mesh(tubeGeo, tubeMat);
        body.add(tube);
        tentacleGeos.push(tubeGeo);
        tentacleMats.push(tubeMat);
        tentacleMeshes.push(tube);
        tentacleSeeds.push(seed);
      }

      // Red eye — single emissive marker on the front of the body
      const eyeGeo = new THREE.SphereGeometry(0.05, 16, 12);
      const eyeMat = new THREE.MeshBasicMaterial({ color: danger, transparent: true, opacity: 0.95 });
      const eye = new THREE.Mesh(eyeGeo, eyeMat);
      eye.position.set(0.0, 0.18, 0.6);
      body.add(eye);

      // Eye glow halo — flat sprite-like quad facing camera
      const glowGeo = new THREE.PlaneGeometry(0.45, 0.45);
      const glowMat = new THREE.MeshBasicMaterial({
        color: danger, transparent: true, opacity: 0.18,
        depthWrite: false, blending: THREE.AdditiveBlending,
      });
      const glow = new THREE.Mesh(glowGeo, glowMat);
      glow.position.copy(eye.position);
      body.add(glow);

      // Cold drifting dust — sparse, monochrome
      const pCount = 220;
      const positions = new Float32Array(pCount * 3);
      const seeds     = new Float32Array(pCount);
      for (let i = 0; i < pCount; i++) {
        positions[i * 3]     = (Math.random() - 0.5) * 14;
        positions[i * 3 + 1] = (Math.random() - 0.5) * 9;
        positions[i * 3 + 2] = (Math.random() - 0.5) * 10 - 2;
        seeds[i] = Math.random() * Math.PI * 2;
      }
      const pGeo = new THREE.BufferGeometry();
      pGeo.setAttribute("position", new THREE.BufferAttribute(positions, 3));
      const pMat = new THREE.PointsMaterial({
        color: dim, size: 0.025, sizeAttenuation: true, transparent: true, opacity: 0.45,
      });
      const dust = new THREE.Points(pGeo, pMat);

      scene.add(body, dust);
      // Faint cold backdrop tint for depth — a near-black box
      scene.background = null;

      const disposables: Disposable[] = [
        bodyGeo, bodyWireMat, hullGeo, hullMat,
        eyeGeo, eyeMat, glowGeo, glowMat,
        pGeo, pMat,
        ...tentacleGeos, ...tentacleMats,
      ];
      const meshes: THREE.Object3D[] = [body, dust];

      return {
        update(dt, now) {
          const speed = reduced ? 0.05 : 1;
          // Body drifts slowly — menacing, not frantic
          body.rotation.y += dt * 0.18 * speed;
          body.rotation.x += dt * 0.05 * speed;

          // Body bob
          body.position.y = Math.sin(now * 0.0008) * 0.06;

          // Eye pulse — irregular, like a sensor scan
          const pulse = 0.7 + (Math.sin(now * 0.003) * 0.5 + 0.5) *
                              (Math.sin(now * 0.011) * 0.5 + 0.5) * 0.3;
          eyeMat.opacity = pulse;
          glowMat.opacity = 0.10 + pulse * 0.18;
          glow.lookAt(camera.position);

          // Tentacle subtle scale pulse to suggest articulation
          tentacleMeshes.forEach((t, i) => {
            const wave = 1 + Math.sin(now * 0.002 + tentacleSeeds[i]) * 0.04;
            t.scale.setScalar(wave);
          });

          // Dust drift — slow downward parallax + subtle x sway
          const pos = pGeo.attributes.position as THREE.BufferAttribute;
          const arr = pos.array as Float32Array;
          for (let i = 0; i < pCount; i++) {
            arr[i * 3 + 1] -= dt * 0.08 * speed;
            arr[i * 3]     += Math.sin(now * 0.0006 + seeds[i]) * 0.0015;
            if (arr[i * 3 + 1] < -5) arr[i * 3 + 1] = 5;
          }
          pos.needsUpdate = true;
        },
        dispose() {
          meshes.forEach((m) => scene.remove(m));
          disposables.forEach((d) => d.dispose());
        },
      };
    }

    // ---------------- Theme switcher ----------------
    let currentReal = isRealWorld();
    let bundle: SceneBundle = currentReal ? buildReal() : buildSim();
    if (hudRecEl) hudRecEl.textContent = currentReal ? "◉ scan" : "◉ rec";

    const themeObs = new MutationObserver(() => {
      const realNow = isRealWorld();
      if (realNow === currentReal) return;
      currentReal = realNow;
      bundle.dispose();
      bundle = realNow ? buildReal() : buildSim();
      if (hudRecEl) hudRecEl.textContent = realNow ? "◉ scan" : "◉ rec";
    });
    themeObs.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });

    // ---------------- Renderer plumbing ----------------
    const resize = () => {
      const w = mount.clientWidth;
      const h = mount.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    };
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(mount);

    const target = { x: 0, y: 0 };
    const onMove = (e: PointerEvent) => {
      const r = mount.getBoundingClientRect();
      target.x = ((e.clientX - r.left) / r.width - 0.5) * 0.8;
      target.y = ((e.clientY - r.top) / r.height - 0.5) * 0.8;
    };
    mount.addEventListener("pointermove", onMove);
    mount.addEventListener("pointerleave", () => { target.x = 0; target.y = 0; });

    let visible = true;
    const io = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }, { threshold: 0 });
    io.observe(mount);

    let raf = 0;
    let last = performance.now();
    let fpsAccum = 0, fpsFrames = 0, fpsTimer = 0;

    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      if (!visible) return;

      bundle.update(dt, now);

      // Camera parallax — slower in realworld for weight/menace
      const damp = isRealWorld() ? 0.025 : 0.05;
      camera.position.x += (target.x * 1.2 - camera.position.x) * damp;
      camera.position.y += (-target.y * 1.2 - camera.position.y) * damp;
      camera.lookAt(0, 0, 0);

      renderer.render(scene, camera);

      fpsTimer += dt; fpsFrames++; fpsAccum += 1 / dt;
      if (fpsTimer >= 0.5) {
        if (fpsEl) fpsEl.textContent = String(Math.round(fpsAccum / fpsFrames));
        fpsTimer = 0; fpsAccum = 0; fpsFrames = 0;
      }
    };
    raf = requestAnimationFrame(loop);

    window.addEventListener("beforeunload", () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      io.disconnect();
      themeObs.disconnect();
      bundle.dispose();
      renderer.dispose();
    });
  });
</script>
