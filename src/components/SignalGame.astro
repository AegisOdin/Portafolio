---
// A small, intentionally idle arcade cabinet. No game runs before user input.
---

<div class="signal-game frame" data-signal-game data-label="/dev/arcade">
  <header class="sg-header">
    <span class="sg-program"><span aria-hidden="true">⌘</span> signal.run</span>
    <span class="sg-status" data-game-status>LISTO</span>
  </header>

  <div class="sg-scoreboard">
    <div><span data-game-copy="score">SEÑAL</span><strong data-game-score>0000</strong></div>
    <div><span data-game-copy="best">RÉCORD LOCAL</span><strong data-game-best>0000</strong></div>
    <div><span data-game-copy="level">NIVEL</span><strong data-game-level>01</strong></div>
  </div>

  <div class="sg-screen" tabindex="0" role="group" aria-label="Tablero de Snake. Usa las flechas o WASD para moverte y espacio para pausar." data-game-board>
    <svg class="sg-grid" viewBox="0 0 400 400" aria-hidden="true">
      <defs>
        <pattern id="signal-grid" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M20 0H0V20" fill="none" stroke="currentColor" stroke-width="0.6" class="sg-grid-lines" />
        </pattern>
      </defs>
      <rect width="400" height="400" fill="url(#signal-grid)" />
      <g class="sg-snake" data-game-snake>
        <rect x="141" y="201" width="18" height="18" opacity="0.4" />
        <rect x="161" y="201" width="18" height="18" opacity="0.6" />
        <rect x="181" y="201" width="18" height="18" opacity="0.8" />
        <rect x="201" y="201" width="18" height="18" />
      </g>
      <path class="sg-food" d="M290 122L298 130L290 138L282 130Z" data-game-food />
    </svg>
    <div class="sg-overlay" data-game-overlay>
      <span class="sg-overlay-code" aria-hidden="true">[ SIGNAL / 01 ]</span>
      <strong data-game-title>Encuentra la señal.</strong>
      <p data-game-message>Recoge los diamantes. Evita los bordes y tu propia estela.</p>
      <span class="sg-overlay-cursor" aria-hidden="true">_</span>
    </div>
    <span class="sg-corner sg-corner-tl" aria-hidden="true"></span>
    <span class="sg-corner sg-corner-br" aria-hidden="true"></span>
  </div>

  <div class="sg-actions">
    <button type="button" class="sg-button sg-button-primary" data-game-start disabled>Iniciar partida</button>
    <button type="button" class="sg-button" data-game-pause disabled data-game-copy="pause">Pausar</button>
    <button type="button" class="sg-restart" data-game-restart disabled data-game-copy="restart">Reiniciar</button>
  </div>

  <div class="sg-controls">
    <p class="sg-help" data-game-copy="help">Flechas / WASD · mover<br />Espacio · pausar<br /><span>El juego se pausa cuando sales.</span></p>
    <div class="sg-dpad" role="group" aria-label="Controles de dirección" data-game-dpad>
      <button class="sg-direction sg-up" type="button" data-game-direction="up" aria-label="Mover arriba">↑</button>
      <button class="sg-direction sg-left" type="button" data-game-direction="left" aria-label="Mover izquierda">←</button>
      <span class="sg-dpad-center" aria-hidden="true">·</span>
      <button class="sg-direction sg-right" type="button" data-game-direction="right" aria-label="Mover derecha">→</button>
      <button class="sg-direction sg-down" type="button" data-game-direction="down" aria-label="Mover abajo">↓</button>
    </div>
  </div>
  <p class="sg-announcement sr-only" aria-live="polite" aria-atomic="true" data-game-announcement></p>
  <noscript><p class="sg-no-script">Activa JavaScript para jugar a Signal.</p></noscript>
</div>

<script>
  type Point = { x: number; y: number };
  type Direction = "up" | "down" | "left" | "right";
  type GameState = "ready" | "running" | "paused" | "ended" | "won";

  const translations = {
    es: {
      score: "SEÑAL", best: "RÉCORD LOCAL", level: "NIVEL",
      ready: "LISTO", running: "EN CURSO", paused: "EN PAUSA", ended: "SEÑAL PERDIDA", won: "COMPLETADO",
      start: "Iniciar partida", resume: "Continuar", retry: "Volver a jugar", active: "En marcha", pause: "Pausar", restart: "Reiniciar",
      readyTitle: "Encuentra la señal.", pausedTitle: "Señal en espera.", endedTitle: "Una señal más.", wonTitle: "Circuito completo.",
      readyMessage: "Recoge los diamantes. Evita los bordes y tu propia estela.",
      pausedMessage: "Tu partida sigue aquí. Pulsa Continuar cuando estés listo.",
      endedMessage: "La estela chocó. Cada intento es un nuevo recorrido.",
      wonMessage: "Has llenado el tablero. La señal está completa.",
      help: "Flechas / WASD · mover\nEspacio · pausar\nEl juego se pausa cuando sales.",
      board: "Tablero de Snake. Usa las flechas o WASD para moverte y espacio para pausar.",
      controls: "Controles de dirección", up: "Mover arriba", down: "Mover abajo", left: "Mover izquierda", right: "Mover derecha",
      points: "puntos",
    },
    en: {
      score: "SIGNAL", best: "LOCAL BEST", level: "LEVEL",
      ready: "READY", running: "RUNNING", paused: "PAUSED", ended: "SIGNAL LOST", won: "COMPLETE",
      start: "Start game", resume: "Resume", retry: "Play again", active: "Running", pause: "Pause", restart: "Restart",
      readyTitle: "Find the signal.", pausedTitle: "Signal on hold.", endedTitle: "One more signal.", wonTitle: "Circuit complete.",
      readyMessage: "Collect the diamonds. Avoid the edges and your own trail.",
      pausedMessage: "Your game is still here. Press Resume when you are ready.",
      endedMessage: "Your trail collided. Every attempt is a new path.",
      wonMessage: "You filled the board. The signal is complete.",
      help: "Arrows / WASD · move\nSpace · pause\nThe game pauses when you leave.",
      board: "Snake game board. Use arrows or WASD to move and space to pause.",
      controls: "Direction controls", up: "Move up", down: "Move down", left: "Move left", right: "Move right",
      points: "points",
    },
  };

  function mountSignalGame(root: HTMLElement) {
    const board = root.querySelector<HTMLElement>("[data-game-board]")!;
    const snakeGroup = root.querySelector<SVGGElement>("[data-game-snake]")!;
    const foodPath = root.querySelector<SVGPathElement>("[data-game-food]")!;
    const overlay = root.querySelector<HTMLElement>("[data-game-overlay]")!;
    const startButton = root.querySelector<HTMLButtonElement>("[data-game-start]")!;
    const pauseButton = root.querySelector<HTMLButtonElement>("[data-game-pause]")!;
    const restartButton = root.querySelector<HTMLButtonElement>("[data-game-restart]")!;
    const announcement = root.querySelector<HTMLElement>("[data-game-announcement]")!;
    const vectors: Record<Direction, Point> = {
      up: { x: 0, y: -1 }, down: { x: 0, y: 1 }, left: { x: -1, y: 0 }, right: { x: 1, y: 0 },
    };
    const keys: Record<string, Direction> = {
      ArrowUp: "up", ArrowDown: "down", ArrowLeft: "left", ArrowRight: "right",
      w: "up", s: "down", a: "left", d: "right",
    };
    const size = 20;
    const recordKey = "nog_signal_best_v1";
    let snake: Point[] = [];
    let food: Point | null = null;
    let direction: Direction = "right";
    let nextDirection: Direction = "right";
    let turnQueued = false;
    let state: GameState = "ready";
    let score = 0;
    let best = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let inViewport = true;

    try {
      const saved = Number(localStorage.getItem(recordKey));
      if (Number.isFinite(saved) && saved >= 0 && saved <= size * size * 10) best = Math.floor(saved);
    } catch { /* A local record is optional when storage is unavailable. */ }

    function copy() {
      return translations[document.documentElement.lang.startsWith("en") ? "en" : "es"];
    }

    function renderStatus(announce = false) {
      const text = copy();
      root.dataset.state = state;
      root.querySelector<HTMLElement>("[data-game-status]")!.textContent = text[state];
      root.querySelector<HTMLElement>("[data-game-score]")!.textContent = String(score).padStart(4, "0");
      root.querySelector<HTMLElement>("[data-game-best]")!.textContent = String(best).padStart(4, "0");
      root.querySelector<HTMLElement>("[data-game-level]")!.textContent = String(Math.min(8, Math.floor(score / 50) + 1)).padStart(2, "0");
      startButton.textContent = state === "running" ? text.active : state === "paused" ? text.resume : state === "ready" ? text.start : text.retry;
      startButton.disabled = state === "running";
      pauseButton.disabled = state !== "running";
      restartButton.disabled = state === "ready";
      root.querySelectorAll<HTMLButtonElement>("[data-game-direction]").forEach((button) => {
        button.disabled = state !== "running";
      });
      overlay.hidden = state === "running";
      if (state !== "running") {
        root.querySelector<HTMLElement>("[data-game-title]")!.textContent = text[`${state}Title`];
        root.querySelector<HTMLElement>("[data-game-message]")!.textContent = text[`${state}Message`];
      }
      if (announce) announcement.textContent = `${text[state]}. ${score} ${text.points}.`;
    }

    function applyLanguage() {
      const text = copy();
      root.querySelectorAll<HTMLElement>("[data-game-copy]").forEach((element) => {
        const key = element.dataset.gameCopy as keyof typeof text;
        element.textContent = text[key];
      });
      board.setAttribute("aria-label", text.board);
      root.querySelector<HTMLElement>("[data-game-dpad]")!.setAttribute("aria-label", text.controls);
      root.querySelectorAll<HTMLButtonElement>("[data-game-direction]").forEach((button) => {
        button.setAttribute("aria-label", text[button.dataset.gameDirection as Direction]);
      });
      renderStatus();
    }

    function placeFood(): Point | null {
      const available: Point[] = [];
      for (let y = 0; y < size; y++) {
        for (let x = 0; x < size; x++) {
          if (!snake.some((part) => part.x === x && part.y === y)) available.push({ x, y });
        }
      }
      return available.length ? available[Math.floor(Math.random() * available.length)] : null;
    }

    function drawBoard() {
      const fragment = document.createDocumentFragment();
      snake.forEach((part, index) => {
        const cell = document.createElementNS("http://www.w3.org/2000/svg", "rect");
        cell.setAttribute("x", String(part.x * 20 + 1));
        cell.setAttribute("y", String(part.y * 20 + 1));
        cell.setAttribute("width", "18");
        cell.setAttribute("height", "18");
        cell.setAttribute("opacity", index === 0 ? "1" : String(Math.max(0.3, 0.78 - index * 0.015)));
        fragment.appendChild(cell);
      });
      snakeGroup.replaceChildren(fragment);
      foodPath.style.display = food ? "" : "none";
      if (food) {
        const x = food.x * 20 + 10;
        const y = food.y * 20 + 10;
        foodPath.setAttribute("d", `M${x} ${y - 8}L${x + 8} ${y}L${x} ${y + 8}L${x - 8} ${y}Z`);
      }
    }

    function stopTimer() {
      clearTimeout(timer);
      timer = undefined;
    }

    function pause() {
      if (state !== "running") return;
      stopTimer();
      state = "paused";
      renderStatus(true);
    }

    function overlayIsOpen() {
      return ["cmdbar", "hire-modal", "matrix-scene", "access-modal", "boot"].some((id) => {
        const element = document.getElementById(id);
        return element && getComputedStyle(element).display !== "none";
      });
    }

    function scheduleTick() {
      timer = setTimeout(tick, Math.max(110, 205 - (score / 10) * 4));
    }

    function tick() {
      if (state !== "running") return;
      if (document.hidden || !inViewport || overlayIsOpen()) {
        pause();
        return;
      }
      direction = nextDirection;
      turnQueued = false;
      const vector = vectors[direction];
      const head = { x: snake[0].x + vector.x, y: snake[0].y + vector.y };
      const grows = food !== null && head.x === food.x && head.y === food.y;
      // The tail vacates its cell on a normal step, so moving into it is valid.
      const solid = grows ? snake : snake.slice(0, -1);
      if (head.x < 0 || head.x >= size || head.y < 0 || head.y >= size || solid.some((part) => part.x === head.x && part.y === head.y)) {
        state = "ended";
        stopTimer();
        renderStatus(true);
        return;
      }
      snake.unshift(head);
      if (grows) {
        score += 10;
        if (score > best) {
          best = score;
          try { localStorage.setItem(recordKey, String(best)); } catch { /* Keep the in-memory record. */ }
        }
        food = placeFood();
        if (!food) state = "won";
        renderStatus(state === "won");
      } else snake.pop();
      drawBoard();
      if (state === "running") scheduleTick();
    }

    function start(fresh = false) {
      if (document.hidden || !inViewport || overlayIsOpen()) return;
      stopTimer();
      if (fresh || state !== "paused") {
        snake = [{ x: 10, y: 10 }, { x: 9, y: 10 }, { x: 8, y: 10 }, { x: 7, y: 10 }];
        direction = "right";
        nextDirection = "right";
        turnQueued = false;
        score = 0;
        food = placeFood();
      }
      // Transfer focus before renderStatus disables the start button.
      board.focus({ preventScroll: true });
      state = "running";
      renderStatus(true);
      drawBoard();
      scheduleTick();
    }

    function steer(next: Direction) {
      if (state !== "running" || turnQueued || next === direction) return;
      const currentVector = vectors[direction];
      const candidate = vectors[next];
      if (currentVector.x + candidate.x === 0 && currentVector.y + candidate.y === 0) return;
      nextDirection = next;
      turnQueued = true;
    }

    startButton.addEventListener("click", () => start());
    pauseButton.addEventListener("click", pause);
    restartButton.addEventListener("click", () => start(true));
    root.querySelectorAll<HTMLButtonElement>("[data-game-direction]").forEach((button) => {
      button.addEventListener("click", () => steer(button.dataset.gameDirection as Direction));
    });
    root.addEventListener("keydown", (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey || overlayIsOpen()) return;
      const next = keys[event.key] ?? keys[event.key.toLowerCase()];
      if (next && state === "running") {
        event.preventDefault();
        event.stopPropagation();
        steer(next);
      } else if (event.code === "Space" && event.target === board) {
        event.preventDefault();
        event.stopPropagation();
        if (event.repeat) return;
        if (state === "running") pause();
        else if (state === "paused") start();
      } else if (event.key === "Escape") pause();
    });
    root.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !root.contains(event.relatedTarget)) pause();
    });
    document.addEventListener("visibilitychange", () => { if (document.hidden) pause(); });
    window.addEventListener("blur", pause);

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(([entry]) => {
        inViewport = entry.isIntersecting && entry.intersectionRatio >= 0.4;
        if (!inViewport) pause();
      }, { threshold: [0, 0.4] });
      observer.observe(board);
    }

    const overlayObserver = new MutationObserver(() => { if (overlayIsOpen()) pause(); });
    ["cmdbar", "hire-modal", "matrix-scene", "access-modal", "boot"].forEach((id) => {
      const element = document.getElementById(id);
      if (element) overlayObserver.observe(element, { attributes: true, attributeFilter: ["class", "style", "hidden", "aria-hidden"] });
    });
    new MutationObserver(applyLanguage).observe(document.documentElement, { attributes: true, attributeFilter: ["lang"] });
    applyLanguage();
  }

  document.querySelectorAll<HTMLElement>("[data-signal-game]").forEach(mountSignalGame);
</script>

<style>
  .signal-game { padding: 1.2rem; max-width: 32rem; width: 100%; }
  .sg-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.1rem 0 1rem; border-bottom: 1px solid color-mix(in srgb, var(--accent) 20%, transparent); }
  .sg-program { font-size: 0.8rem; color: var(--color-ink); }
  .sg-program > span { margin-right: 0.45rem; color: var(--accent); }
  .sg-status { font-size: 0.55rem; letter-spacing: 0.1em; color: var(--accent); text-align: right; }
  .sg-scoreboard { display: grid; grid-template-columns: 1fr 1fr auto; gap: 1rem; padding: 1rem 0; }
  .sg-scoreboard > div { display: grid; gap: 0.15rem; }
  .sg-scoreboard span { font-size: 0.55rem; letter-spacing: 0.1em; color: var(--color-muted); }
  .sg-scoreboard strong { font-family: var(--font-crt); font-size: 2rem; font-weight: 400; line-height: 1; color: var(--accent); }
  .sg-scoreboard > div:nth-child(2) strong { color: var(--color-ink); }
  .sg-scoreboard > div:last-child { text-align: right; }
  .sg-screen { position: relative; width: 100%; aspect-ratio: 1; max-width: 25rem; margin-inline: auto; background: var(--color-bg); border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent); outline-offset: 5px; }
  .sg-grid { width: 100%; height: 100%; display: block; }
  .sg-grid-lines { color: color-mix(in srgb, var(--accent) 16%, transparent); }
  .sg-snake { fill: var(--accent); }
  .sg-food { fill: var(--color-amber); stroke: var(--color-bg); stroke-width: 1; }
  .sg-overlay { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 1.5rem; gap: 0.8rem; text-align: center; background: color-mix(in srgb, var(--color-bg) 88%, transparent); }
  .sg-overlay[hidden] { display: none; }
  .sg-overlay-code { color: var(--accent); font-size: 0.6rem; letter-spacing: 0.18em; }
  .sg-overlay strong { font-family: var(--font-crt); color: var(--color-ink); font-size: clamp(1.7rem, 4vw, 2.7rem); font-weight: 400; line-height: 1; }
  .sg-overlay p { font-size: 0.7rem; max-width: 27ch; line-height: 1.8; color: var(--color-muted); margin: 0; }
  .sg-overlay-cursor { font-family: var(--font-crt); font-size: 1.7rem; color: var(--accent); line-height: 0.7; }
  .sg-corner { position: absolute; width: 0.7rem; height: 0.7rem; pointer-events: none; border-color: var(--accent); }
  .sg-corner-tl { top: -1px; left: -1px; border-top: 2px solid; border-left: 2px solid; }
  .sg-corner-br { bottom: -1px; right: -1px; border-bottom: 2px solid; border-right: 2px solid; }
  .sg-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-top: 1rem; }
  .sg-button { min-height: 44px; padding: 0.6rem 0.85rem; border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent); background: color-mix(in srgb, var(--accent) 5%, transparent); color: var(--color-ink); font-size: 0.66rem; cursor: pointer; }
  .sg-button-primary { flex: 1; background: var(--accent); border-color: var(--accent); color: var(--color-bg); font-weight: 700; }
  .sg-button:hover:not(:disabled), .sg-direction:hover:not(:disabled) { box-shadow: inset 0 0 0 1px var(--accent); }
  .sg-restart { min-height: 44px; padding: 0.4rem 0.3rem; font-size: 0.6rem; color: var(--color-muted); cursor: pointer; }
  .sg-restart:hover:not(:disabled) { color: var(--accent); }
  button:disabled { opacity: 0.38; cursor: default; }
  .sg-controls { display: flex; justify-content: space-between; align-items: center; gap: 0.8rem; margin-top: 1rem; }
  .sg-help { font-size: 0.6rem; color: var(--color-muted); line-height: 1.9; white-space: pre-line; margin: 0; }
  .sg-dpad { display: grid; grid-template-columns: repeat(3, 44px); grid-template-rows: repeat(2, 44px); gap: 3px; flex-shrink: 0; }
  .sg-direction { border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent); background: color-mix(in srgb, var(--accent) 5%, transparent); color: var(--accent); font-size: 1rem; cursor: pointer; touch-action: manipulation; }
  .sg-direction:active { background: color-mix(in srgb, var(--accent) 20%, transparent); }
  .sg-up { grid-column: 2; grid-row: 1; }
  .sg-left { grid-column: 1; grid-row: 2; }
  .sg-right { grid-column: 3; grid-row: 2; }
  .sg-down { grid-column: 2; grid-row: 2; }
  .sg-dpad-center { grid-column: 1; grid-row: 1; align-self: end; padding-bottom: 0.3rem; padding-left: 0.4rem; color: var(--color-muted); }
  .sg-screen:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .sg-no-script { font-size: 0.7rem; color: var(--color-amber); }
  @media (max-width: 380px) {
    .signal-game { padding: 0.85rem; }
    .sg-controls { align-items: flex-start; }
    .sg-help { font-size: 0.55rem; }
    .sg-dpad { grid-template-columns: repeat(3, 44px); gap: 2px; }
    .sg-restart { flex-basis: 100%; min-height: 32px; }
  }
  @media print { .sg-actions, .sg-controls, .sg-screen, .sg-no-script { display: none; } }
</style>
