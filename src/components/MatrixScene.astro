---
// Morpheus pill scene — easter egg. Triggered by __cmd.matrix().
---

<div id="matrix-scene" class="matrix-scene" aria-hidden="true" role="dialog" aria-label="The Matrix — choose">
  <canvas id="matrix-rain" class="matrix-rain"></canvas>
  <div class="matrix-vignette"></div>
  <div class="matrix-noise"></div>

  <div class="matrix-stage">
    <header class="matrix-meta">
      <span class="meta-dot"></span>
      <span class="meta-text">INCOMING_TRANSMISSION · NEBUCHADNEZZAR</span>
      <span class="meta-time" id="matrix-time">--:--:--</span>
    </header>

    <div class="morpheus">
      <div class="morpheus-portrait" aria-hidden="true">
        <pre class="morpheus-ascii">┌──────────────────┐
│  ░░██████████░░  │
│  ██▓▓▓▓▓▓▓▓▓▓██  │
│  ▓ ▓▓████▓▓▓▓▓█  │
│  ▓██░  ░██▓▓▓▓█  │
│  ▓██░  ░██▓▓▓▓█  │
│  ▓████████▓▓▓▓█  │
│  ▓▓▓▓░░░░▓▓▓▓▓█  │
│   ▓▓██████▓▓▓█   │
└──────────────────┘</pre>
        <div class="morpheus-name">MORPHEUS<span class="cursor-tick">_</span></div>
      </div>

      <div class="dialogue">
        <p class="line" style="--d:0.4s">I imagine, right now, you must be feeling a bit like Alice.</p>
        <p class="line" style="--d:2.4s">Tumbling down the rabbit hole. Hm?</p>
        <p class="line" style="--d:4.4s">This is your <span class="emph">last chance</span>. After this, there is no turning back.</p>
        <p class="line" style="--d:6.6s">You take the <em class="hl-blue">blue pill</em> — the story ends, you wake up in your bed and believe whatever you want to believe.</p>
        <p class="line" style="--d:9.0s">You take the <em class="hl-red">red pill</em> — you stay in Wonderland, and I show you how deep the rabbit hole goes.</p>
        <p class="line prompt" style="--d:11.4s">Remember: all I'm offering is the truth. Nothing more.</p>
      </div>
    </div>

    <div class="pill-tray">
      <button class="pill-3d pill-blue" id="pill-blue" type="button" aria-label="Take the blue pill — stay in the simulation">
        <span class="pill-shape"></span>
        <span class="pill-shine"></span>
        <span class="pill-aura"></span>
        <div class="pill-caption">
          <span class="kbd">←</span>
          <span class="cap-line">BLUE PILL</span>
          <span class="cap-sub">// stay in the simulation</span>
        </div>
      </button>

      <div class="pill-divider" aria-hidden="true">
        <span>OR</span>
      </div>

      <button class="pill-3d pill-red" id="pill-red" type="button" aria-label="Take the red pill — see the real world">
        <span class="pill-shape"></span>
        <span class="pill-shine"></span>
        <span class="pill-aura"></span>
        <div class="pill-caption">
          <span class="cap-line">RED PILL</span>
          <span class="cap-sub">// see the real world</span>
          <span class="kbd">→</span>
        </div>
      </button>
    </div>

    <footer class="matrix-foot">
      <span>WHAT IS REAL?</span>
      <span class="dim">{ <span id="matrix-choice-hint">awaiting input — press ← / →</span> }</span>
      <button id="matrix-exit" type="button" aria-label="exit scene">[ esc ]</button>
    </footer>
  </div>

  <!-- White flash overlay for transition -->
  <div id="matrix-flash" class="matrix-flash" aria-hidden="true"></div>
</div>

<style>
  /* ============================================================
     MATRIX SCENE — overlay
     ============================================================ */
  .matrix-scene {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    background: #000;
    color: #b6ffb6;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    overflow: hidden;
    isolation: isolate;
  }
  .matrix-scene.open { display: block; }

  .matrix-rain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    opacity: 0.55;
    filter: blur(0.3px);
  }

  .matrix-vignette {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      radial-gradient(ellipse at center, transparent 0%, rgba(0,0,0,0.65) 65%, #000 100%),
      linear-gradient(180deg, rgba(0,0,0,0.4), transparent 30%, transparent 70%, rgba(0,0,0,0.4));
    pointer-events: none;
  }

  .matrix-noise {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    opacity: 0.08;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.7'/></svg>");
  }

  .matrix-stage {
    position: relative;
    z-index: 10;
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: 1.5rem;
    padding: 1.5rem clamp(1rem, 4vw, 3rem) 1.25rem;
    max-width: 1280px;
    margin: 0 auto;
    color: #c8ffb6;
  }

  /* ---- meta header ---- */
  .matrix-meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(155, 230, 155, 0.7);
    border-bottom: 1px solid rgba(57, 255, 20, 0.18);
    padding-bottom: 0.7rem;
    animation: meta-in 0.6s ease-out both;
  }
  .meta-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #39ff14;
    box-shadow: 0 0 10px #39ff14, 0 0 18px rgba(57,255,20,0.5);
    animation: dot-pulse 1.8s ease-in-out infinite;
  }
  .meta-time { margin-left: auto; color: rgba(57, 255, 20, 0.85); }

  /* ---- morpheus + dialogue ---- */
  .morpheus {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
    padding-top: clamp(0.5rem, 2vh, 2rem);
  }

  .morpheus-portrait {
    text-align: center;
    color: #39ff14;
    text-shadow: 0 0 4px rgba(57,255,20,0.6);
    animation: portrait-in 0.9s 0.2s ease-out both;
  }
  .morpheus-ascii {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 9px;
    line-height: 1.05;
    margin: 0;
    white-space: pre;
    letter-spacing: 0;
  }
  .morpheus-name {
    margin-top: 0.6rem;
    font-family: "Special Elite", "Courier New", monospace;
    font-size: 14px;
    letter-spacing: 0.5em;
    color: #c8ffb6;
    padding-left: 0.5em;
  }
  .cursor-tick {
    color: #39ff14;
    animation: blink 1s steps(2, start) infinite;
  }

  .dialogue {
    max-width: 62ch;
    font-size: clamp(15px, 1.6vw, 19px);
    line-height: 1.65;
    color: rgba(220, 255, 215, 0.92);
  }
  .dialogue .line {
    margin: 0 0 0.95em;
    opacity: 0;
    transform: translateY(8px);
    animation: line-in 0.9s var(--d, 0s) ease-out forwards;
    text-wrap: pretty;
  }
  .dialogue .emph {
    color: #39ff14;
    font-style: italic;
    text-shadow: 0 0 6px rgba(57,255,20,0.4);
  }
  .dialogue .hl-blue {
    color: #5ec8ff;
    font-style: normal;
    font-weight: 600;
    text-shadow: 0 0 8px rgba(94,200,255,0.5);
  }
  .dialogue .hl-red {
    color: #ff4d4d;
    font-style: normal;
    font-weight: 600;
    text-shadow: 0 0 8px rgba(255,77,77,0.55);
  }
  .dialogue .prompt {
    color: rgba(155, 230, 155, 0.65);
    font-style: italic;
    font-size: 0.92em;
    border-left: 2px solid rgba(57,255,20,0.4);
    padding-left: 0.9em;
  }

  /* ---- pills ---- */
  .pill-tray {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: clamp(1rem, 3vh, 2.5rem) 0;
    opacity: 0;
    animation: tray-in 0.8s 13.0s ease-out forwards;
  }

  .pill-3d {
    position: relative;
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    width: clamp(140px, 18vw, 220px);
    height: clamp(140px, 18vw, 220px);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s cubic-bezier(.2,.7,.1,1);
  }
  .pill-3d:focus-visible { outline: none; }
  .pill-3d:focus-visible .pill-shape { filter: brightness(1.15); }

  .pill-shape {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%) rotate(-22deg);
    width: 78%;
    height: 32%;
    border-radius: 999px;
    transition: transform 0.5s cubic-bezier(.2,.7,.1,1), filter 0.4s;
  }
  .pill-shine {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%) rotate(-22deg);
    width: 70%;
    height: 8%;
    margin-top: -7%;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.85) 50%, transparent 100%);
    opacity: 0.85;
    filter: blur(1.5px);
    pointer-events: none;
  }
  .pill-aura {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    height: 90%;
    border-radius: 50%;
    pointer-events: none;
    transition: opacity 0.4s, transform 0.5s;
    opacity: 0.5;
  }

  .pill-red .pill-shape {
    background:
      radial-gradient(ellipse at 30% 30%, #ff8888 0%, #ff3a3a 30%, #c40000 65%, #5a0000 100%);
    box-shadow:
      inset 0 -10px 18px rgba(0,0,0,0.6),
      inset 0 6px 10px rgba(255,255,255,0.25),
      0 12px 24px rgba(0,0,0,0.7),
      0 0 30px rgba(255,40,40,0.45);
  }
  .pill-red .pill-aura {
    background: radial-gradient(circle, rgba(255,40,40,0.55) 0%, transparent 60%);
    filter: blur(20px);
  }

  .pill-blue .pill-shape {
    background:
      radial-gradient(ellipse at 30% 30%, #b8e6ff 0%, #4aa6ff 30%, #0a4ec2 65%, #001a4d 100%);
    box-shadow:
      inset 0 -10px 18px rgba(0,0,0,0.6),
      inset 0 6px 10px rgba(255,255,255,0.3),
      0 12px 24px rgba(0,0,0,0.7),
      0 0 30px rgba(60,140,255,0.45);
  }
  .pill-blue .pill-aura {
    background: radial-gradient(circle, rgba(60,140,255,0.55) 0%, transparent 60%);
    filter: blur(20px);
  }

  .pill-3d:hover {
    transform: translateY(-4px);
  }
  .pill-3d:hover .pill-shape {
    transform: translate(-50%, -50%) rotate(-22deg) scale(1.08);
    filter: brightness(1.15);
  }
  .pill-3d:hover .pill-aura {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.25);
  }

  .pill-caption {
    position: absolute;
    top: calc(100% + 0.3rem);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    text-align: center;
    white-space: nowrap;
  }
  .cap-line {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.35em;
  }
  .pill-red .cap-line { color: #ff6464; text-shadow: 0 0 8px rgba(255,77,77,0.5); }
  .pill-blue .cap-line { color: #6cb6ff; text-shadow: 0 0 8px rgba(108,182,255,0.5); }

  .cap-sub {
    font-size: 11px;
    color: rgba(180, 230, 180, 0.5);
    letter-spacing: 0.1em;
    font-style: italic;
  }
  .kbd {
    display: inline-block;
    font-size: 10px;
    padding: 1px 5px;
    border: 1px solid rgba(155, 230, 155, 0.4);
    border-radius: 3px;
    color: rgba(155, 230, 155, 0.7);
    margin-bottom: 0.2rem;
  }

  .pill-divider {
    color: rgba(155, 230, 155, 0.35);
    font-size: 11px;
    letter-spacing: 0.4em;
    border-top: 1px solid rgba(155, 230, 155, 0.18);
    border-bottom: 1px solid rgba(155, 230, 155, 0.18);
    padding: 0.4em 0.9em;
    user-select: none;
  }

  /* ---- foot ---- */
  .matrix-foot {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(155, 230, 155, 0.55);
    border-top: 1px solid rgba(57, 255, 20, 0.18);
    padding-top: 0.7rem;
    animation: meta-in 0.6s 0.4s ease-out both;
  }
  .matrix-foot .dim { color: rgba(155, 230, 155, 0.4); margin-left: auto; }
  #matrix-exit {
    background: transparent;
    border: 1px solid rgba(155, 230, 155, 0.3);
    color: rgba(180, 230, 180, 0.7);
    padding: 0.3rem 0.7rem;
    font-family: inherit;
    font-size: 11px;
    letter-spacing: 0.22em;
    cursor: pointer;
    transition: all 0.2s;
  }
  #matrix-exit:hover {
    color: #39ff14;
    border-color: #39ff14;
    box-shadow: 0 0 10px rgba(57,255,20,0.3);
  }

  /* ---- flash transition ---- */
  .matrix-flash {
    position: fixed;
    inset: 0;
    z-index: 250;
    background: #fff;
    opacity: 0;
    pointer-events: none;
    mix-blend-mode: screen;
  }
  .matrix-flash.fire {
    animation: flash-fire 1.4s cubic-bezier(.2,.7,.1,1) forwards;
  }

  /* ---- keyframes ---- */
  @keyframes meta-in {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes portrait-in {
    from { opacity: 0; transform: scale(0.96); filter: blur(4px); }
    to   { opacity: 1; transform: none; filter: none; }
  }
  @keyframes line-in {
    to { opacity: 1; transform: none; }
  }
  @keyframes tray-in {
    to { opacity: 1; }
  }
  @keyframes dot-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.35); opacity: 0.6; }
  }
  @keyframes blink {
    0%, 49%   { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  @keyframes flash-fire {
    0%   { opacity: 0; }
    18%  { opacity: 1; }
    100% { opacity: 0; }
  }

  /* ---- responsive ---- */
  @media (max-width: 720px) {
    .matrix-stage { padding: 1rem; gap: 1rem; }
    .morpheus { grid-template-columns: 1fr; gap: 1rem; }
    .morpheus-portrait { justify-self: center; }
    .morpheus-ascii { font-size: 7.5px; }
    .dialogue { font-size: 14px; }
    .pill-tray { gap: 1.25rem; }
    .pill-divider { display: none; }
    .cap-sub { display: none; }
  }
  @media (max-width: 480px) {
    .morpheus-ascii { font-size: 6.5px; }
    .dialogue { font-size: 13px; line-height: 1.55; }
    .dialogue .line { margin-bottom: 0.6em; }
  }

  /* ---- skip on reduced motion ---- */
  @media (prefers-reduced-motion: reduce) {
    .matrix-rain { display: none; }
    .dialogue .line { opacity: 1; transform: none; animation: none; }
    .pill-tray { opacity: 1; animation: none; }
    .meta-dot { animation: none; }
    .cursor-tick { animation: none; }
  }
</style>

<script>
  (() => {
    const scene = document.getElementById("matrix-scene") as HTMLDivElement | null;
    const flash = document.getElementById("matrix-flash") as HTMLDivElement | null;
    const exitBtn = document.getElementById("matrix-exit") as HTMLButtonElement | null;
    const pillRed = document.getElementById("pill-red") as HTMLButtonElement | null;
    const pillBlue = document.getElementById("pill-blue") as HTMLButtonElement | null;
    const timeEl = document.getElementById("matrix-time") as HTMLSpanElement | null;
    const choiceHint = document.getElementById("matrix-choice-hint") as HTMLSpanElement | null;
    const canvas = document.getElementById("matrix-rain") as HTMLCanvasElement | null;

    if (!scene || !flash || !exitBtn || !pillRed || !pillBlue || !canvas) return;

    // ---------- Digital rain ----------
    const ctx = canvas.getContext("2d");
    const chars = "ｦｱｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜ0123456789ABCDEFZ:.\"=*+-<>¦|".split("");
    let columns = 0;
    let drops: number[] = [];
    let raf = 0;
    let running = false;
    let fontSize = 14;

    function resize() {
      if (!canvas || !ctx) return;
      const dpr = window.devicePixelRatio || 1;
      canvas.width = Math.floor(window.innerWidth * dpr);
      canvas.height = Math.floor(window.innerHeight * dpr);
      canvas.style.width = window.innerWidth + "px";
      canvas.style.height = window.innerHeight + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      fontSize = window.innerWidth < 600 ? 12 : 16;
      columns = Math.ceil(window.innerWidth / fontSize);
      drops = Array.from({ length: columns }, () => Math.random() * -50);
    }

    function frame() {
      if (!ctx || !canvas) return;
      ctx.fillStyle = "rgba(0, 0, 0, 0.08)";
      ctx.fillRect(0, 0, window.innerWidth, window.innerHeight);

      ctx.font = `${fontSize}px JetBrains Mono, monospace`;

      for (let i = 0; i < columns; i++) {
        const ch = chars[Math.floor(Math.random() * chars.length)];
        const x = i * fontSize;
        const y = drops[i] * fontSize;

        // head of stream — bright white
        ctx.fillStyle = "rgba(220, 255, 220, 0.95)";
        ctx.fillText(ch, x, y);

        // trail
        ctx.fillStyle = "rgba(57, 255, 20, 0.85)";
        ctx.fillText(ch, x, y - fontSize);

        if (y > window.innerHeight && Math.random() > 0.975) {
          drops[i] = 0;
        }
        drops[i] += 0.5 + Math.random() * 0.4;
      }

      if (running) raf = requestAnimationFrame(frame);
    }

    function startRain() {
      if (running) return;
      running = true;
      resize();
      window.addEventListener("resize", resize);
      raf = requestAnimationFrame(frame);
    }

    function stopRain() {
      running = false;
      cancelAnimationFrame(raf);
      window.removeEventListener("resize", resize);
    }

    // ---------- Time ticker ----------
    let timeRaf = 0;
    function tickTime() {
      if (!timeEl) return;
      const d = new Date();
      const hh = String(d.getHours()).padStart(2, "0");
      const mm = String(d.getMinutes()).padStart(2, "0");
      const ss = String(d.getSeconds()).padStart(2, "0");
      const ms = String(d.getMilliseconds()).padStart(3, "0");
      timeEl.textContent = `${hh}:${mm}:${ss}.${ms.slice(0, 2)}`;
      timeRaf = window.setTimeout(tickTime, 53);
    }
    function stopTime() { clearTimeout(timeRaf); }

    // ---------- Open / close ----------
    let isOpen = false;
    function open() {
      if (isOpen) return;
      isOpen = true;
      scene!.classList.add("open");
      scene!.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      startRain();
      tickTime();
      // Focus first pill for a11y keyboard nav
      setTimeout(() => pillBlue?.focus(), 50);
    }

    function close() {
      if (!isOpen) return;
      isOpen = false;
      scene!.classList.remove("open");
      scene!.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      stopRain();
      stopTime();
    }

    // ---------- Pill choices ----------
    function chooseBlue() {
      if (choiceHint) choiceHint.textContent = "// blue selected — returning to simulation";
      // Gentle fade-back. Keep CRT theme as-is.
      flash!.style.background = "rgba(60, 140, 255, 0.9)";
      flash!.classList.remove("fire");
      // Reflow to restart animation
      void flash!.offsetWidth;
      flash!.classList.add("fire");
      setTimeout(() => {
        close();
        flash!.classList.remove("fire");
        flash!.style.background = "#fff";
      }, 1200);
    }

    function chooseRed() {
      if (choiceHint) choiceHint.textContent = "// red selected — waking up";
      // Big white flash, swap theme to realworld, persist.
      flash!.style.background = "#fff";
      flash!.classList.remove("fire");
      void flash!.offsetWidth;
      flash!.classList.add("fire");
      setTimeout(() => {
        document.documentElement.setAttribute("data-theme", "realworld");
        try { localStorage.setItem("theme", "realworld"); } catch {}
        close();
        flash!.classList.remove("fire");
      }, 700);
    }

    pillBlue.addEventListener("click", chooseBlue);
    pillRed.addEventListener("click", chooseRed);
    exitBtn.addEventListener("click", close);

    // Keyboard: ← blue, → red, esc close
    document.addEventListener("keydown", (e) => {
      if (!isOpen) return;
      if (e.key === "Escape") { e.preventDefault(); close(); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); chooseBlue(); }
      else if (e.key === "ArrowRight") { e.preventDefault(); chooseRed(); }
    });

    // Expose globally so cmd bar / hidden buttons can trigger
    (window as any).__matrix = { open, close };

    // Restore realworld theme from storage on load handled in CommandBar persist
  })();
</script>
