---
import { Image } from "astro:assets";
import bluePill from "../assets/pill-blue.png";
import redPill from "../assets/pill-red.png";
---

<div id="matrix-scene" class="matrix-scene" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="matrix-title">
  <canvas id="matrix-rain" class="matrix-rain" aria-hidden="true"></canvas>
  <div class="matrix-vignette" aria-hidden="true"></div>
  <div class="matrix-stage">
    <header class="matrix-meta">
      <span class="meta-source"><span class="meta-dot" aria-hidden="true"></span>nebuchadnezzar / transmission</span>
      <span class="meta-time" id="matrix-time" aria-hidden="true">--:--:--</span>
      <button id="matrix-exit" type="button" aria-label="Cerrar escena" data-i18n-attr="aria-label:matrix.close">[ esc ] <span aria-hidden="true">×</span></button>
    </header>
    <div class="matrix-content">
      <div class="matrix-intro">
        <p class="matrix-channel" data-i18n="matrix.channel">Morpheus tiene una pregunta.</p>
        <h2 id="matrix-title" data-i18n="matrix.title">¿Hasta dónde quieres llegar?</h2>
        <p class="matrix-description" data-i18n="matrix.description">Dos formas de ver el mismo mundo. Elige la tuya.</p>
      </div>
      <div class="pill-tray">
        <button class="pill-choice pill-blue" id="pill-blue" type="button" aria-label="Píldora azul: permanecer en la simulación">
          <span class="pill-choice-meta"><span data-i18n="matrix.blueMode">La simulación</span><span class="kbd" aria-hidden="true">←</span></span>
          <span class="pill-art"><Image src={bluePill} alt="" class="pill-image" widths={[240,480,720]} sizes="(max-width: 640px) 44vw, 300px" width={600} format="webp" quality={85} loading="lazy" /></span>
          <span class="pill-caption"><span class="cap-line">Píldora azul</span><span class="cap-sub">Quédate en la terminal. Todo sigue como lo conoces.</span></span>
          <span class="pill-action" data-i18n="matrix.blueAction">Elegir azul <span aria-hidden="true">↗</span></span>
        </button>
        <button class="pill-choice pill-red" id="pill-red" type="button" aria-label="Píldora roja: descubrir el mundo real">
          <span class="pill-choice-meta"><span data-i18n="matrix.redMode">El mundo real</span><span class="kbd" aria-hidden="true">→</span></span>
          <span class="pill-art"><Image src={redPill} alt="" class="pill-image" widths={[240,480,720]} sizes="(max-width: 640px) 44vw, 300px" width={600} format="webp" quality={85} loading="lazy" /></span>
          <span class="pill-caption"><span class="cap-line">Píldora roja</span><span class="cap-sub">Sal de la simulación. Descubre el otro lado del portafolio.</span></span>
          <span class="pill-action" data-i18n="matrix.redAction">Elegir roja <span aria-hidden="true">↗</span></span>
        </button>
      </div>
      <p class="matrix-quote" lang="en">“All I'm offering is the truth. Nothing more.” <span>— Morpheus</span></p>
    </div>
    <footer class="matrix-foot">
      <span data-i18n="matrix.return">Siempre puedes volver a elegir.</span>
      <span id="matrix-choice-hint" role="status" aria-live="polite">Elige una píldora o usa ← / →</span>
    </footer>
  </div>
  <div id="matrix-flash" class="matrix-flash" aria-hidden="true"></div>
</div>

<style>
  .matrix-scene { position: fixed; inset: 0; z-index: 200; display: none; overflow-y: auto; overflow-x: hidden; overscroll-behavior: contain; isolation: isolate; background: var(--color-matrix-black); color: var(--color-matrix-ink); font-family: "JetBrains Mono", ui-monospace, monospace; }
  .matrix-scene.open { display: block; }
  .matrix-rain { position: fixed; inset: 0; width: 100%; height: 100%; opacity: 0.22; pointer-events: none; }
  .matrix-vignette { position: fixed; inset: 0; pointer-events: none; background: radial-gradient(ellipse at center, var(--color-matrix-black) 12%, color-mix(in srgb, var(--color-matrix-black) 85%, transparent) 52%, transparent 100%); }
  .matrix-stage { position: relative; z-index: 1; display: flex; flex-direction: column; min-height: 100svh; max-width: 72rem; padding: 1.25rem clamp(1rem, 4vw, 3rem); margin-inline: auto; }
  .matrix-meta { display: flex; align-items: center; gap: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid color-mix(in srgb, var(--color-matrix-green) 20%, transparent); font-size: 0.6875rem; color: var(--color-matrix-muted); }
  .meta-source { display: flex; align-items: center; gap: 0.7rem; }
  .meta-dot { width: 0.375rem; height: 0.375rem; border-radius: 50%; background: var(--color-matrix-green); }
  .meta-time { margin-left: auto; font-variant-numeric: tabular-nums; }
  #matrix-exit { display: inline-flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 2.75rem; padding: 0.4rem 0.75rem; border: 1px solid color-mix(in srgb, var(--color-matrix-muted) 30%, transparent); color: var(--color-matrix-ink); font: inherit; cursor: pointer; background: var(--color-matrix-black); }
  #matrix-exit:hover { border-color: var(--color-matrix-ink); }
  .matrix-content { width: 100%; margin-block: auto; padding-block: clamp(1.75rem, 5vh, 3.75rem); }
  .matrix-intro { text-align: center; max-width: 46rem; margin-inline: auto; }
  .matrix-channel { color: var(--color-matrix-green); font-size: 0.75rem; margin-bottom: 1rem; }
  #matrix-title { font-family: "VT323", monospace; font-size: clamp(2.75rem, 6vw, 5rem); font-weight: 400; line-height: 0.98; text-wrap: balance; letter-spacing: -0.015em; }
  .matrix-description { max-width: 42ch; margin: 1rem auto 0; color: var(--color-matrix-muted); font-size: 0.8125rem; line-height: 1.7; text-wrap: balance; }
  .pill-tray { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: min(100%, 47rem); margin: clamp(1.5rem, 4vh, 3rem) auto 0; gap: clamp(0.875rem, 4vw, 3rem); }
  .pill-choice { --pill-color: var(--color-pill-blue); appearance: none; display: flex; flex-direction: column; align-items: stretch; min-width: 0; padding: clamp(0.75rem, 2vw, 1.5rem); background: var(--color-matrix-black); border: 1px solid color-mix(in srgb, var(--pill-color) 28%, transparent); color: var(--color-matrix-ink); cursor: pointer; font: inherit; text-align: left; transition: border-color 180ms, box-shadow 180ms; }
  .pill-red { --pill-color: var(--color-pill-red); }
  .pill-choice:hover, .pill-choice:focus-visible { border-color: var(--pill-color); box-shadow: 0 0 2rem -1.25rem var(--pill-color); }
  .pill-choice:focus-visible, #matrix-exit:focus-visible { outline: 2px solid var(--color-matrix-ink); outline-offset: 4px; }
  .pill-choice-meta { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; font-size: 0.6875rem; color: var(--color-matrix-muted); }
  .kbd { color: var(--pill-color); font-size: 1rem; }
  .pill-art { display: grid; place-items: center; aspect-ratio: 1.4; min-width: 0; overflow: hidden; margin-block: 0.5rem; }
  .pill-image { display: block; width: 100%; height: 100%; object-fit: contain; max-height: 15rem; mix-blend-mode: screen; transition: transform 280ms ease-out; }
  .pill-choice:hover .pill-image { transform: scale(1.045) rotate(-3deg); }
  .pill-caption { display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }
  .cap-line { color: var(--pill-color); font-family: "VT323", monospace; font-size: clamp(1.75rem, 3vw, 2.75rem); line-height: 1; }
  .cap-sub { color: var(--color-matrix-muted); font-size: 0.75rem; line-height: 1.7; text-wrap: pretty; }
  .pill-action { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; padding-top: 1rem; margin-top: 1.25rem; border-top: 1px solid color-mix(in srgb, var(--pill-color) 22%, transparent); color: var(--pill-color); font-size: 0.75rem; }
  .matrix-quote { text-align: center; margin-top: 1.75rem; font-size: 0.6875rem; line-height: 1.8; color: var(--color-matrix-muted); }
  .matrix-quote span { display: inline-block; color: var(--color-matrix-green); }
  .matrix-foot { display: flex; justify-content: space-between; gap: 1rem; padding-top: 1rem; border-top: 1px solid color-mix(in srgb, var(--color-matrix-green) 20%, transparent); color: var(--color-matrix-muted); font-size: 0.625rem; line-height: 1.7; }
  .matrix-flash { position: fixed; inset: 0; z-index: 2; opacity: 0; pointer-events: none; }
  .matrix-flash.fire { animation: flash-fire 700ms ease-out forwards; }
  @keyframes flash-fire { 0%, 100% { opacity: 0; } 30% { opacity: 0.24; } }
  @media (max-width: 640px) {
    .matrix-stage { padding: 0.75rem 1rem; }
    .matrix-meta { gap: 0.75rem; font-size: 0.5625rem; }
    .meta-source { max-width: 21ch; }
    .meta-time { display: none; }
    #matrix-exit { margin-left: auto; flex-shrink: 0; }
    .matrix-channel { font-size: 0.6875rem; }
    .matrix-description { font-size: 0.75rem; }
    .pill-choice-meta { font-size: 0.5625rem; }
    .pill-art { aspect-ratio: 1.1; }
    .cap-sub { font-size: 0.6875rem; }
    .pill-action { font-size: 0.6875rem; }
    .matrix-quote { max-width: 36ch; margin-inline: auto; }
    .matrix-foot { flex-direction: column; gap: 0.3rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .matrix-rain, .matrix-flash { display: none; }
    .pill-choice, .pill-image { transition: none; }
    .pill-choice:hover .pill-image { transform: none; }
  }
  @media print { .matrix-scene { display: none !important; } }
</style>

<script>
  import { i18n } from "../i18n";
  (() => {
    const copy = (key: string) => i18n[document.documentElement.lang === "en" ? "en" : "es"][key];
    const scene = document.getElementById("matrix-scene") as HTMLDivElement | null;
    const flash = document.getElementById("matrix-flash") as HTMLDivElement | null;
    const exitBtn = document.getElementById("matrix-exit") as HTMLButtonElement | null;
    const pillRed = document.getElementById("pill-red") as HTMLButtonElement | null;
    const pillBlue = document.getElementById("pill-blue") as HTMLButtonElement | null;
    const timeEl = document.getElementById("matrix-time") as HTMLSpanElement | null;
    const choiceHint = document.getElementById("matrix-choice-hint") as HTMLSpanElement | null;
    const canvas = document.getElementById("matrix-rain") as HTMLCanvasElement | null;
    const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (!scene || !flash || !exitBtn || !pillRed || !pillBlue || !canvas) return;

    // ---------- Digital rain ----------
    const ctx = canvas.getContext("2d");
    const chars = "ｦｱｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜ0123456789ABCDEFZ:.\"=*+-<>¦|".split("");
    let columns = 0;
    let drops: number[] = [];
    let raf = 0;
    let running = false;
    let fontSize = 14;

    function resize() {
      if (!canvas || !ctx) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(window.innerWidth * dpr);
      canvas.height = Math.floor(window.innerHeight * dpr);
      canvas.style.width = window.innerWidth + "px";
      canvas.style.height = window.innerHeight + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      fontSize = window.innerWidth < 600 ? 12 : 16;
      columns = Math.ceil(window.innerWidth / fontSize);
      drops = Array.from({ length: columns }, () => Math.random() * -50);
    }

    function frame() {
      if (!ctx || !canvas) return;
      ctx.fillStyle = "rgba(0, 0, 0, 0.08)";
      ctx.fillRect(0, 0, window.innerWidth, window.innerHeight);

      ctx.font = `${fontSize}px JetBrains Mono, monospace`;

      for (let i = 0; i < columns; i++) {
        const ch = chars[Math.floor(Math.random() * chars.length)];
        const x = i * fontSize;
        const y = drops[i] * fontSize;

        // head of stream — bright white
        ctx.fillStyle = "rgba(220, 255, 220, 0.95)";
        ctx.fillText(ch, x, y);

        // trail
        ctx.fillStyle = "rgba(57, 255, 20, 0.85)";
        ctx.fillText(ch, x, y - fontSize);

        if (y > window.innerHeight && Math.random() > 0.975) {
          drops[i] = 0;
        }
        drops[i] += 0.5 + Math.random() * 0.4;
      }

      if (running) raf = requestAnimationFrame(frame);
    }

    function startRain() {
      if (running || motionPreference.matches || document.hidden) return;
      running = true;
      resize();
      window.addEventListener("resize", resize);
      raf = requestAnimationFrame(frame);
    }

    function stopRain() {
      running = false;
      cancelAnimationFrame(raf);
      window.removeEventListener("resize", resize);
    }

    // ---------- Time ticker ----------
    let timeRaf = 0;
    function tickTime() {
      if (!timeEl) return;
      const d = new Date();
      const hh = String(d.getHours()).padStart(2, "0");
      const mm = String(d.getMinutes()).padStart(2, "0");
      const ss = String(d.getSeconds()).padStart(2, "0");
      const ms = String(d.getMilliseconds()).padStart(3, "0");
      timeEl.textContent = `${hh}:${mm}:${ss}.${ms.slice(0, 2)}`;
      timeRaf = window.setTimeout(tickTime, 53);
    }
    function stopTime() { clearTimeout(timeRaf); }

    // ---------- Open / close ----------
    let isOpen = false;
    let choosing = false;
    let choiceTimer = 0;
    let previousFocus: HTMLElement | null = null;
    let previousOverflow = "";
    let background: Array<{ element: HTMLElement; inert: boolean }> = [];
    function isInRealWorld() {
      return document.documentElement.getAttribute("data-theme") === "realworld";
    }
    function adaptCaptions() {
      const realWorld = isInRealWorld();
      const blueCap = pillBlue!.querySelector(".cap-line") as HTMLElement | null;
      const blueSub = pillBlue!.querySelector(".cap-sub") as HTMLElement | null;
      const redCap = pillRed!.querySelector(".cap-line") as HTMLElement | null;
      const redSub = pillRed!.querySelector(".cap-sub") as HTMLElement | null;
      const blueDescription = copy(realWorld ? "matrix.blueReturn" : "matrix.blueStay");
      const redDescription = copy(realWorld ? "matrix.redStay" : "matrix.redEnter");
      pillBlue!.setAttribute("aria-label", `${copy("matrix.blue")}: ${blueDescription}`);
      pillRed!.setAttribute("aria-label", `${copy("matrix.red")}: ${redDescription}`);
      if (blueCap) blueCap.textContent = copy("matrix.blue");
      if (redCap) redCap.textContent = copy("matrix.red");
      if (blueSub) blueSub.textContent = blueDescription;
      if (redSub) redSub.textContent = redDescription;
    }
    function open() {
      if (isOpen) return;
      isOpen = true;
      choosing = false;
      previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      previousOverflow = document.body.style.overflow;
      background = Array.from(document.body.children)
        .filter((element): element is HTMLElement => element instanceof HTMLElement && element !== scene && !element.contains(scene) && !["SCRIPT", "STYLE", "LINK"].includes(element.tagName))
        .map((element) => ({ element, inert: element.inert }));
      background.forEach(({ element }) => { element.inert = true; });
      adaptCaptions();
      if (choiceHint) choiceHint.textContent = copy("matrix.hint");
      scene!.classList.add("open");
      scene!.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      startRain();
      scene!.scrollTop = 0;
      if (!motionPreference.matches) tickTime();
      else if (timeEl) timeEl.textContent = "CONNECTED";
      // Closing is immediately available without scrolling past the dialogue.
      exitBtn!.focus({ preventScroll: true });
    }

    function close() {
      if (!isOpen) return;
      isOpen = false;
      choosing = false;
      clearTimeout(choiceTimer);
      flash!.classList.remove("fire");
      flash!.style.background = "#fff";
      scene!.classList.remove("open");
      scene!.setAttribute("aria-hidden", "true");
      document.body.style.overflow = previousOverflow;
      background.forEach(({ element, inert }) => { element.inert = inert; });
      background = [];
      stopRain();
      stopTime();
      previousFocus?.focus({ preventScroll: true });
      previousFocus = null;
    }

    // ---------- Pill choices ----------
    // Blue pill: "wake up in your bed" = restore the simulation.
    //   - From realworld → revert to phosphor-green default.
    //   - From any sim theme → keep current state, just close.
    function chooseBlue() {
      if (!isOpen || choosing) return;
      choosing = true;
      const wasReal = isInRealWorld();
      if (choiceHint) {
        choiceHint.textContent = copy("matrix.blueSelected");
      }
      flash!.style.background = wasReal
        ? "rgba(60, 140, 255, 0.95)"
        : "rgba(60, 140, 255, 0.7)";
      if (!motionPreference.matches) {
        flash!.classList.remove("fire");
        void flash!.offsetWidth;
        flash!.classList.add("fire");
      }
      choiceTimer = window.setTimeout(() => {
        if (wasReal) {
          document.documentElement.removeAttribute("data-theme");
          try { localStorage.setItem("theme", "green"); } catch { /* localStorage blocked */ }
        }
        close();
        flash!.classList.remove("fire");
        flash!.style.background = "#fff";
      }, motionPreference.matches ? 0 : 700);
    }

    // Red pill: "see how deep the rabbit hole goes" = realworld theme.
    //   - From any theme → switch to realworld and persist.
    //   - Already realworld → close (no change).
    function chooseRed() {
      if (!isOpen || choosing) return;
      choosing = true;
      const alreadyReal = isInRealWorld();
      if (choiceHint) {
        choiceHint.textContent = copy("matrix.redSelected");
      }
      flash!.style.background = "#fff";
      if (!motionPreference.matches) {
        flash!.classList.remove("fire");
        void flash!.offsetWidth;
        flash!.classList.add("fire");
      }
      choiceTimer = window.setTimeout(() => {
        if (!alreadyReal) {
          document.documentElement.setAttribute("data-theme", "realworld");
          try { localStorage.setItem("theme", "realworld"); } catch { /* localStorage blocked */ }
        }
        close();
        flash!.classList.remove("fire");
      }, motionPreference.matches ? 0 : 700);
    }

    pillBlue.addEventListener("click", chooseBlue);
    pillRed.addEventListener("click", chooseRed);
    exitBtn.addEventListener("click", close);

    // Keyboard: ← blue, → red, esc close
    document.addEventListener("keydown", (e) => {
      if (!isOpen) return;
      if (e.key === "Tab") {
        const controls = [exitBtn!, pillBlue!, pillRed!];
        const first = controls[0];
        const last = controls[controls.length - 1];
        if (e.shiftKey && (document.activeElement === first || !scene!.contains(document.activeElement))) {
          e.preventDefault(); last.focus();
        } else if (!e.shiftKey && (document.activeElement === last || !scene!.contains(document.activeElement))) {
          e.preventDefault(); first.focus();
        }
      } else if (e.key === "Escape") { e.preventDefault(); close(); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); chooseBlue(); }
      else if (e.key === "ArrowRight") { e.preventDefault(); chooseRed(); }
    });

    motionPreference.addEventListener("change", () => {
      stopRain();
      stopTime();
      if (!isOpen) return;
      if (!motionPreference.matches) { startRain(); tickTime(); }
      else if (timeEl) timeEl.textContent = "CONNECTED";
    });
    document.addEventListener("visibilitychange", () => {
      stopRain();
      stopTime();
      if (isOpen && !document.hidden && !motionPreference.matches) { startRain(); tickTime(); }
    });

    // Expose globally so cmd bar / hidden buttons can trigger
    window.__matrix = { open, close };

    // Restore realworld theme from storage on load handled in CommandBar persist
  })();
</script>
