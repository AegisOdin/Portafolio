---
interface Props {
  cmd: string;
  label?: string;
  labelKey?: string;
  heading?: string;
  headingKey?: string;
}
const { cmd, label, labelKey, heading, headingKey } = Astro.props;
const a11yHeading = heading ?? cmd;
---
<header class="section-heading">
  <div class="flex items-baseline gap-3 flex-wrap" aria-hidden="true">
    <span class="sigil text-sm">neftali@portfolio</span>
    <span class="text-[var(--color-muted)] text-sm">~</span>
    <span class="sigil text-sm">$</span>
    <code class="text-[var(--color-phosphor)] glow-soft text-sm md:text-base">{cmd}</code>
    {label && <span class="text-[var(--color-muted)] text-xs ml-auto">// <span data-i18n={labelKey}>{label}</span></span>}
  </div>
  <h2 class="display" data-i18n={headingKey}>{a11yHeading}</h2>
</header>
