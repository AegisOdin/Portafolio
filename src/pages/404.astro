---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 · Segmentation fault — Neftali Odín García Ramírez"
  description="Página no encontrada. Vuelve al portafolio de Neftali Odín García Ramírez — Desarrollador Full Stack en Morelia, MX."
>
  <main
    id="main"
    class="max-w-3xl mx-auto px-5 md:px-8 py-24 md:py-32 min-h-[80vh] grid-bg"
  >
    <article class="frame p-6 md:p-8 font-mono" data-label="/dev/null">
      <header>
        <p
          class="text-[var(--color-amber)] glow-soft text-xs tracking-widest mb-3"
          aria-label="error code"
        >
          ⟶ ERR_NOT_FOUND · 404
        </p>
        <h1
          class="display aberrate text-phosphor text-6xl md:text-8xl leading-[0.9] mb-6"
        >
          4<span class="text-[var(--color-amber)]">0</span>4
        </h1>
      </header>

      <section aria-labelledby="not-found-summary">
        <h2 id="not-found-summary" class="sr-only">
          Resumen del error
        </h2>
        <p class="text-[var(--color-ink)]/90 mb-6 leading-relaxed">
          <span class="sigil">&gt;</span> Segmentation fault. La ruta solicitada
          no existe en este servidor.
        </p>
        <pre
          class="text-xs md:text-sm text-[var(--color-muted)] mb-8 overflow-x-auto"
        >$ cat /var/log/portfolio.log
[ERR] route_not_found: redirige al índice.</pre>
      </section>

      <nav aria-label="Navegación de recuperación">
        <h2 id="not-found-nav" class="sr-only">Acciones disponibles</h2>
        <ul class="flex flex-wrap gap-3 text-xs md:text-sm list-none p-0 m-0">
          <li>
            <a href="/" class="no-underline">
              <span
                class="pill !text-[var(--color-bg)] !bg-[var(--color-phosphor)] !border-[var(--color-phosphor)] !text-sm !px-4 !py-2"
                >▸ cd ~ · volver al inicio</span
              >
            </a>
          </li>
          <li>
            <a href="/#projects" class="no-underline">
              <span class="pill !text-sm !px-4 !py-2">▸ ls ./projects</span>
            </a>
          </li>
          <li>
            <a href="/#experience" class="no-underline">
              <span class="pill !text-sm !px-4 !py-2">▸ cat experience.log</span>
            </a>
          </li>
          <li>
            <a href="/#contact" class="no-underline">
              <span
                class="pill !text-[var(--color-amber)] !border-[var(--color-amber)] !text-sm !px-4 !py-2"
                >$ mail compose</span
              >
            </a>
          </li>
          <li>
            <a href="/CV_Neftali_Odin_Garcia.pdf" download class="no-underline">
              <span class="pill !text-sm !px-4 !py-2">▼ download CV</span>
            </a>
          </li>
        </ul>
      </nav>
    </article>
  </main>
</BaseLayout>
