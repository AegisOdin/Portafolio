---
// Boot sequence — plays once per session
---
<div id="boot" class="fixed inset-0 z-[100] bg-[var(--color-bg)] text-[var(--color-phosphor)] font-mono text-[13px] md:text-[14px] leading-[1.5] p-6 md:p-10 overflow-hidden hidden">
  <div class="max-w-3xl mx-auto pt-[10vh]" id="boot-stream">
    <pre class="text-[var(--color-amber)] glow-soft mb-6 text-[10px] md:text-[12px] leading-[1.05] whitespace-pre">
███╗   ██╗ ██████╗  ██████╗     ██████╗ ███████╗
████╗  ██║██╔═══██╗██╔════╝    ██╔═══██╗██╔════╝
██╔██╗ ██║██║   ██║██║  ███╗   ██║   ██║███████╗
██║╚██╗██║██║   ██║██║   ██║   ██║   ██║╚════██║
██║ ╚████║╚██████╔╝╚██████╔╝██╗╚██████╔╝███████║
╚═╝  ╚═══╝ ╚═════╝  ╚═════╝ ╚═╝ ╚═════╝ ╚══════╝
   nog-os v26.05 · phosphor build · MX-mor
</pre>
    <div id="boot-lines"></div>
    <div class="mt-6 text-[var(--color-muted)] text-xs"><span class="sigil">[esc]</span> saltar · <span class="sigil">[enter / espacio]</span> continuar</div>
  </div>
</div>

<script>
  const KEY = "nog_boot_done_v1";
  const boot = document.getElementById("boot")!;
  const lines = document.getElementById("boot-lines")!;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  let timer: number | undefined;
  let finished = false;

  const seq: Array<[string, number]> = [
    ["[ OK ] CPU ............... 1x neftali.cortex @ 3.6 GHz", 60],
    ["[ OK ] MEMORY ............ 16 GiB ECC", 50],
    ["[ OK ] DISK .............. /dev/sda — ext4 mounted", 50],
    ["[ OK ] NETWORK ........... eth0 up · MX-MOR-01", 80],
    ["[ .. ] AUTH .............. validating identity", 220],
    ["[ OK ] AUTH .............. neftali.odin verified", 80],
    ["[ OK ] LOCALE ............ es_MX.UTF-8 (en_US fallback)", 60],
    ["[ OK ] STACK ............. ts · vue · nuxt · laravel · node", 60],
    ["[ OK ] DAEMON ............ portfolio.service started", 120],
    ["", 60],
    ["welcome, visitor. press / to summon command bar.", 0],
  ];

  function done(immediate = false) {
    if (finished) return;
    finished = true;
    window.clearTimeout(timer);
    timer = undefined;
    window.removeEventListener("keydown", skip, true);
    boot.removeEventListener("click", skip);
    document.removeEventListener("visibilitychange", onVisibilityChange);
    reduced.removeEventListener("change", onMotionChange);
    try { sessionStorage.setItem(KEY, "1"); } catch { /* Boot is optional without storage. */ }
    // A skipped or reduced-motion boot must release the page immediately.
    if (immediate || reduced.matches) {
      boot.remove();
      return;
    }
    boot.style.pointerEvents = "none";
    boot.setAttribute("aria-hidden", "true");
    boot.style.transition = "opacity .35s ease, filter .35s ease";
    boot.style.opacity = "0";
    boot.style.filter = "blur(6px)";
    timer = window.setTimeout(() => { timer = undefined; boot.remove(); }, 360);
  }

  function skip(event: KeyboardEvent | MouseEvent) {
    if (event instanceof KeyboardEvent) {
      if (event.key !== "Escape" && event.key !== "Enter" && event.key !== " ") return;
      event.preventDefault();
      event.stopPropagation();
    }
    done(true);
  }

  function onVisibilityChange() {
    if (document.hidden) done(true);
  }

  function onMotionChange() {
    if (reduced.matches) done(true);
  }

  function run() {
    let seen: boolean;
    try { seen = Boolean(sessionStorage.getItem(KEY)); }
    catch { done(true); return; }
    if (seen || reduced.matches || document.hidden) {
      done(true);
      return;
    }
    boot.classList.remove("hidden");
    window.addEventListener("keydown", skip, true);
    boot.addEventListener("click", skip);
    document.addEventListener("visibilitychange", onVisibilityChange);
    reduced.addEventListener("change", onMotionChange);

    let i = 0;
    function next() {
      if (finished) return;
      if (i >= seq.length) { timer = window.setTimeout(() => done(), 500); return; }
      const [t, d] = seq[i++];
      const div = document.createElement("div");
      div.textContent = t;
      if (t.startsWith("[ OK ]")) div.style.color = "var(--color-phosphor)";
      if (t.startsWith("[ .. ]")) div.style.color = "var(--color-amber)";
      if (t.startsWith("welcome")) {
        div.style.color = "var(--color-amber)";
        div.classList.add("glow-soft");
      }
      lines.appendChild(div);
      timer = window.setTimeout(next, d);
    }
    next();
  }

  run();
</script>
