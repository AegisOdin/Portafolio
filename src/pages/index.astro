---
import BaseLayout from "../layouts/BaseLayout.astro";
import BootSequence from "../components/BootSequence.astro";
import CommandBar from "../components/CommandBar.astro";
import SectionHeader from "../components/SectionHeader.astro";
import MatrixScene from "../components/MatrixScene.astro";
import AccessModal from "../components/AccessModal.astro";
import SignalCore from "../components/SignalCore.astro";
import ReactiveName from "../components/ReactiveName.astro";
import AnomalyGame from "../components/AnomalyGame.astro";
import ScrollAtmosphere from "../components/ScrollAtmosphere.astro";
import MatrixSentinel from "../components/MatrixSentinel.astro";
import { i18n, type Lang } from "../i18n";

const lang: Lang = "es";
const t = i18n[lang];

const SITE_URL = "https://odingarra.dev";

const projects = [
  {
    slug: "spa-be-perfect",
    name: "Spa Be Perfect",
    org: "Flama Agency",
    role: "Full Stack · autónomo",
    period: "nov 2025 — ago 2026",
    summary:
      t["proj-0-summary"],
    stack: [
      "Nuxt",
      "Vue",
      "TypeScript",
      "Strapi v5",
      "JWT",
      "Socket.IO",
      "AWS S3",
      "MySQL",
    ],
    prod: "https://appbeperfect.com",
    status: "PROD",
  },
  {
    slug: "sim-cle",
    name: "SIM-CLE",
    org: "Instituto Tecnológico de Morelia · Depto. de Idiomas",
    role: "Full Stack · remoto",
    period: "ene 2026 — jun 2026",
    summary:
      "Sistema institucional para centralizar inscripciones, gestión de grupos y seguimiento de alumnos del Centro de Lenguas. Frontend reactivo con Livewire y backend en Laravel.",
    stack: ["Laravel", "Livewire", "PHP", "REST API", "Java", "GitLab", "GitHub", "Git"],
    prod: "https://sim-cle.morelia.tecnm.mx/login",
    status: "COMPLETED",
  },
  {
    slug: "wiki-tekniu",
    name: "Wiki Tekniu",
    org: "Tekniu México",
    role: "Full Stack · híbrido",
    period: "mar 2026 — actualidad",
    summary:
      "Sitio interno para consultar la documentación de los repositorios de Tekniu. Frontend y backend desarrollados en TypeScript, con Next.js en el frontend.",
    stack: ["TypeScript", "Next.js", "React.js"],
    prod: "https://wiki.tekniu.org/login?from=%2F",
    status: "INTERNAL",
  },
];

const experience = [
  {
    id: "tekniu",
    date: "[mar 2026 — actualidad]",
    host: "tekniu.mx",
    url: "https://wiki.tekniu.org/login?from=%2F",
    role: "FULLSTACK",
    state: "ACTIVE",
    mode: "Híbrido · Equipo ágil",
    title: "Desarrollador Full Stack",
    org: "Tekniu México",
    bullets: [
      t["exp-tekniu-b0"],
      t["exp-tekniu-b1"],
      t["exp-tekniu-b2"],
      t["exp-tekniu-b3"],
    ],
    tech: [
      "JavaScript",
      "TypeScript",
      "NestJS",
      "REST API",
      "Odoo",
      "Docker",
      "Linux",
      "PostgreSQL",
      "React.js",
      "Next.js",
      "SSH",
      "XML",
      "HTML",
      "CSS",
    ],
  },
  {
    id: "itm",
    date: "[ene 2026 — jun 2026]",
    host: "itm.edu.mx",
    url: "https://sim-cle.morelia.tecnm.mx/login",
    role: "FULLSTACK",
    state: "COMPLETED",
    mode: "Remoto · Temporal",
    title: "Programador Full Stack",
    org: "Instituto Tecnológico de Morelia",
    bullets: [
      "Desarrollo del sistema SIM-CLE para el Depto. de Idiomas, frontend y backend.",
      "Centralización del control de inscripciones, grupos y seguimiento de alumnos.",
    ],
    tech: [
      "Laravel",
      "Livewire",
      "PHP",
      "Java",
      "REST API",
      "GitLab",
      "GitHub",
      "Git",
    ],
  },
  {
    id: "flama",
    date: "[nov 2025 — ago 2026]",
    host: "flama.agency",
    url: "https://appbeperfect.com",
    role: "FULLSTACK",
    state: "COMPLETED",
    mode: "Remoto · Autónomo",
    title: "Programador Full Stack",
    org: "Flama Agency",
    bullets: [
      t["exp-flama-b0"],
      t["exp-flama-b1"],
      t["exp-flama-b2"],
      t["exp-flama-b3"],
      t["exp-flama-b4"],
    ],
    tech: [
      "Nuxt.js",
      "Vue.js",
      "TypeScript",
      "Strapi",
      "REST API",
      "MySQL",
      "AWS S3",
      "Socket.IO",
      "WebSockets",
      "JWT",
    ],
  },
];

const skills: { key: string; items: string[] }[] = [
  {
    key: "Frontend",
    items: [
      "JavaScript",
      "TypeScript",
      "Vue.js",
      "Nuxt.js",
      "React.js",
      "Next.js",
      "HTML",
      "CSS",
      "Livewire",
    ],
  },
  {
    key: "Backend",
    items: [
      "Node.js",
      "NestJS",
      "PHP",
      "Laravel",
      "Python",
      "Java",
      "Strapi",
      "REST API",
      "Socket.IO",
      "WebSockets",
      "JWT",
    ],
  },
  { key: "Databases", items: ["SQL", "MySQL", "PostgreSQL"] },
  {
    key: "DevOps",
    items: [
      "Docker",
      "AWS",
      "Microsoft Azure",
      "AWS S3",
      "Linux",
      "SSH",
    ],
  },
  { key: "Vcs", items: ["Git", "GitHub", "GitLab"] },
  { key: "Other", items: ["Odoo ERP", "XML", "Microsoft Excel"] },
];

const projectList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Projects · Neftali Odín García Ramírez",
  numberOfItems: projects.length,
  itemListOrder: "https://schema.org/ItemListOrderDescending",
  itemListElement: projects.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "CreativeWork",
      name: p.name,
      url: p.prod,
      description: p.summary,
      keywords: p.stack.join(", "),
      about: p.org,
      creator: { "@id": `${SITE_URL}/#person` },
      author: { "@id": `${SITE_URL}/#person` },
      inLanguage: ["es-MX", "en-US"],
    },
  })),
};
---

<BaseLayout>
  <script
    slot="head-extras"
    type="application/ld+json"
    set:html={JSON.stringify(projectList)}
  />

  <BootSequence />
  <CommandBar />
  <MatrixScene />
  <AccessModal />

  <!-- Top status bar -->
  <header
    class="site-header sticky top-0 z-40 backdrop-blur-md bg-[color-mix(in_srgb,var(--color-bg)_85%,transparent)] border-b border-[color-mix(in_srgb,var(--color-phosphor)_18%,transparent)]"
  >
    <div
      class="max-w-6xl mx-auto px-5 md:px-8 py-2.5 flex items-center justify-between text-[0.6875rem] md:text-xs tracking-widest uppercase"
    >
      <div class="flex items-center gap-3 md:gap-5">
        <span class="text-[var(--color-amber)] glow-soft">●</span>
        <a href="#hero" class="text-[var(--color-muted)] no-underline" aria-label="Volver al inicio">neftali<span class="hidden sm:inline">@portfolio</span>:~$</a>
      </div>
      <nav class="hidden lg:flex items-center gap-5 text-[var(--color-muted)]" aria-label="Navegación principal">
        <a href="#about" class="no-underline hover:text-[var(--color-phosphor)]"
          >whoami</a
        >
        <a
          href="#projects"
          class="no-underline hover:text-[var(--color-phosphor)]">projects</a
        >
        <a
          href="#experience"
          class="no-underline hover:text-[var(--color-phosphor)]">exp.log</a
        >
        <a
          href="#skills"
          class="no-underline hover:text-[var(--color-phosphor)]">skills</a
        >
        <a
          href="#arcade"
          class="no-underline hover:text-[var(--color-phosphor)]">arcade</a
        >
        <a
          href="#contact"
          class="no-underline hover:text-[var(--color-phosphor)]">mail</a
        >
      </nav>
      <div class="flex items-center gap-2">
        <button
          id="mobile-nav-toggle"
          type="button"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-nav"
          class="lg:hidden text-[var(--color-phosphor)] glow-soft pill !bg-transparent !cursor-pointer hover:!bg-[color-mix(in_srgb,var(--color-phosphor)_15%,transparent)]"
        >☰ menu</button>
        <button
          id="lang-toggle"
          type="button"
          aria-label="Cambiar idioma"
          class="text-[var(--color-amber)] glow-soft pill !bg-transparent !cursor-pointer hover:!bg-[color-mix(in_srgb,var(--color-amber)_15%,transparent)]"
          data-i18n="lang.toggle">{t["lang.toggle"]}</button
        >
        <button
          type="button"
          onclick="(window).__cmd?.open()"
          aria-label="Abrir barra de comandos"
          class="hidden lg:inline-block text-[var(--color-phosphor)] glow-soft pill !bg-transparent !cursor-pointer hover:!bg-[color-mix(in_srgb,var(--color-phosphor)_15%,transparent)]"
          >/ cmd</button
        >
      </div>
    </div>

    <!-- Mobile nav drawer -->
    <nav
      id="mobile-nav"
      aria-label="Navegación móvil"
      class="lg:hidden hidden border-t border-[color-mix(in_srgb,var(--color-phosphor)_18%,transparent)] bg-[color-mix(in_srgb,var(--color-bg)_92%,transparent)]"
    >
      <ul class="max-w-6xl mx-auto px-5 py-3 flex flex-col text-sm">
        <li><a href="#about" class="block py-3 no-underline hover:text-[var(--color-phosphor)]" data-mobile-link>whoami</a></li>
        <li><a href="#projects" class="block py-3 no-underline hover:text-[var(--color-phosphor)]" data-mobile-link>projects</a></li>
        <li><a href="#experience" class="block py-3 no-underline hover:text-[var(--color-phosphor)]" data-mobile-link>exp.log</a></li>
        <li><a href="#skills" class="block py-3 no-underline hover:text-[var(--color-phosphor)]" data-mobile-link>skills</a></li>
        <li><a href="#arcade" class="block py-3 no-underline hover:text-[var(--color-phosphor)]" data-mobile-link>arcade</a></li>
        <li><a href="#contact" class="block py-3 no-underline hover:text-[var(--color-phosphor)]" data-mobile-link>mail</a></li>
      </ul>
    </nav>
  </header>

  <main id="main" class="relative">
    <ScrollAtmosphere />
    <MatrixSentinel />
    <!-- ============ HERO ============ -->
    <section
      id="hero"
      class="hero-section relative overflow-hidden"
    >
      <div class="hero-coordinates absolute inset-0 pointer-events-none" aria-hidden="true">
        <!-- decorative ASCII corners -->
        <div
          class="hidden sm:block absolute top-6 left-6 text-[0.6875rem] font-mono text-[color-mix(in_srgb,var(--color-phosphor)_55%,transparent)] leading-[1.3] px-3 py-1.5 border border-[color-mix(in_srgb,var(--color-phosphor)_40%,transparent)]">
          <div>session #0001</div>
          <div>tty: pts/0</div>
          <div>uptime: 0d 0h</div>
        </div>
        <div
          class="hidden md:block absolute top-6 right-6 text-[0.6875rem] font-mono text-[color-mix(in_srgb,var(--color-amber)_65%,transparent)] leading-[1.3] px-3 py-1.5 border border-[color-mix(in_srgb,var(--color-amber)_45%,transparent)] text-right">
          <div>loc: morelia</div>
          <div>mx-mor · gmt-6</div>
          <div>full stack developer</div>
        </div>
      </div>

      <div
        class="hero-layout max-w-6xl mx-auto px-5 md:px-8 relative"
      >
        <div class="hero-copy">
        <div
          class="relative z-1 text-[var(--color-amber)] glow-soft text-xs md:text-sm mb-4 tracking-widest"
          data-i18n="hero.tag"
        >
          {t["hero.tag"]}
        </div>

        <div class="hero-name">
          <ReactiveName />
        </div>

        <div class="hero-description">
          <p
            class="font-mono"
            data-i18n="hero.subtitle"
            set:html={t["hero.subtitle"]}
          />
          <p class="hero-statement" data-i18n="hero.statement">{t["hero.statement"]}</p>
        </div>

        <div class="hero-stack flex flex-wrap gap-2 text-xs">
          <span class="pill">TS / JS</span>
          <span class="pill">Vue · Nuxt</span>
          <span class="pill">React · Next.js</span>
          <span class="pill">Laravel · Livewire</span>
          <span class="pill">Node · Strapi</span>
          <span class="pill">Docker · AWS · Azure</span>
          <span class="pill">PostgreSQL · MySQL</span>
        </div>

        <div class="hero-actions flex flex-wrap items-center gap-3">
          <a href="#projects" class="no-underline">
            <span
              class="pill !text-[var(--color-bg)] !bg-[var(--color-phosphor)] !border-[var(--color-phosphor)] !text-sm !px-4 !py-2"
              data-i18n="hero.btnProjects">{t["hero.btnProjects"]}</span
            >
          </a>
          <a href="/CV_Neftali_Odin_Garcia.pdf" download class="no-underline">
            <span class="pill !text-sm !px-4 !py-2" data-i18n="hero.btnCv"
              >{t["hero.btnCv"]}</span
            >
          </a>
          <button
            type="button"
            onclick="(window).__cmd?.hire()"
            aria-label="Contratar — abrir contacto"
            class="no-underline cursor-pointer"
          >
            <span
              class="pill !text-[var(--color-amber)] !border-[var(--color-amber)] !text-sm !px-4 !py-2"
              data-i18n="hero.btnHire">{t["hero.btnHire"]}</span
            >
          </button>
        </div>

        </div>
        <div class="hero-visual"><SignalCore /></div>
        <div class="hero-baseline">
          <a href="#about" class="hero-scroll no-underline"><span aria-hidden="true">↓</span><span data-i18n="hero.explore">{t["hero.explore"]}</span></a>
          <span class="hero-location">Morelia, México <span aria-hidden="true">/</span> 19.70° N · 101.19° O</span>
        </div>
      </div>
    </section>

    <!-- ============ ABOUT ============ -->
    <section id="about" class="max-w-6xl mx-auto px-5 md:px-8 py-24 md:py-32">
      <SectionHeader
        cmd="whoami"
        label={t["about.label"]}
        labelKey="about.label"
        heading={t["about.heading"]}
        headingKey="about.heading"
      />

      <div class="grid md:grid-cols-12 gap-8 md:gap-12">
        <div
          class="md:col-span-7 text-[var(--color-ink)]/90 leading-relaxed text-sm md:text-base space-y-5"
        >
          <p data-i18n="about.p1" set:html={t["about.p1"]} />
          <p data-i18n="about.p2" set:html={t["about.p2"]} />
          <p class="text-[var(--color-muted)] italic" data-i18n="about.p3">
            {t["about.p3"]}
          </p>
          <div class="frame p-4 text-sm">
            <p class="text-[var(--color-muted)] text-xs mb-2" data-i18n="about.certification">{t["about.certification"]}</p>
            <p lang="en">Certificate of completion: Introduction to subagents</p>
          </div>
        </div>

        <aside class="md:col-span-5">
          <div
            class="identity-panel frame p-5 md:p-6 font-mono text-sm"
            data-label="stats.json"
          >
            <div class="space-y-2.5">
              <div class="flex justify-between gap-4">
                <span class="text-[var(--color-muted)]">role</span>
                <span class="text-[var(--color-phosphor)]">"fullstack_dev"</span
                >
              </div>
              <div class="flex justify-between gap-4">
                <span class="text-[var(--color-muted)]">loc</span>
                <span class="text-[var(--color-ink)]">"morelia, mx"</span>
              </div>
              <div class="flex justify-between gap-4">
                <span class="text-[var(--color-muted)]">edu</span>
                <span class="text-[var(--color-ink)]">"ITM · 2021-2027"</span>
              </div>
              <div class="flex justify-between gap-4">
                <span class="text-[var(--color-muted)]">langs</span>
                <span class="text-[var(--color-ink)]"
                   data-i18n="about.languages">{t["about.languages"]}</span
                >
              </div>
              <div class="flex justify-between gap-4">
                <span class="text-[var(--color-muted)]">active_roles</span>
                <span class="text-[var(--color-amber)]">{experience.filter((e) => e.state === "ACTIVE").length}</span>
              </div>
              <div class="flex justify-between gap-4">
                <span class="text-[var(--color-muted)]">in_production</span>
                <span class="text-[var(--color-phosphor)]">true</span>
              </div>
              <div class="flex justify-between gap-4">
                <span class="text-[var(--color-muted)]">status</span>
                <span class="text-[var(--color-phosphor)] glow">AVAILABLE</span>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- ============ PROJECTS ============ -->
    <section
      id="projects"
      class="max-w-6xl mx-auto px-5 md:px-8 py-24 md:py-32 border-t border-[color-mix(in_srgb,var(--color-phosphor)_15%,transparent)]"
    >
      <SectionHeader
        cmd="ls -la ./projects"
        label={t["projects.label"]}
        labelKey="projects.label"
        heading={t["projects.heading"]}
        headingKey="projects.heading"
      />

      <div class="grid md:grid-cols-2 gap-6 md:gap-8">
        {
          projects.map((p, i) => (
            <article
              class={`project-card frame p-6 md:p-7 relative ${i === 0 ? "project-featured md:col-span-2" : ""}`}
              data-label={`./${p.slug}.md`}
            >
              <div class="project-copy">
              <div class="flex items-start justify-between gap-4 mb-3 flex-wrap">
                <div class="min-w-0 flex-[1_1_14rem]">
                  <div class="text-[var(--color-muted)] text-xs uppercase tracking-widest">
                    {p.org}
                  </div>
                  <h3
                    class={`display ${i === 0 ? "text-5xl md:text-7xl" : "text-4xl md:text-5xl"} text-[var(--color-phosphor)] glow-soft glitch-target mt-1`}
                  >
                    {p.name}
                  </h3>
                </div>
                <span
                  class={`pill ${p.status === "PROD" ? "!text-[var(--color-amber)] !border-[var(--color-amber)]" : ""}`}
                >
                  ● {p.status}
                </span>
              </div>

              <div class="text-xs text-[var(--color-muted)] mb-4">
                <span data-i18n={`proj-${i}-role`}>
                  {t[`proj-${i}-role`] ?? p.role}
                </span>{" "}
                ·{" "}
                <span
                  class="text-[var(--color-ink)]/70"
                  data-i18n={`proj-${i}-period`}
                >
                  {t[`proj-${i}-period`] ?? p.period}
                </span>
              </div>

              <p
                class="text-sm md:text-[0.9375rem] text-[var(--color-ink)]/85 leading-relaxed mb-5"
                data-i18n={`proj-${i}-summary`}
              >
                {t[`proj-${i}-summary`] ?? p.summary}
              </p>

              <div class="flex flex-wrap gap-1.5 mb-5">
                {p.stack.map((s) => (
                  <span class="pill">{s}</span>
                ))}
              </div>

              {p.prod && (
                <a
                  href={p.prod}
                  target="_blank"
                  rel="noopener"
                  data-access-link
                  data-access-host={p.prod.replace(/^https?:\/\//, "").replace(/\/.*$/, "")}
                  class="project-link inline-flex items-center gap-2 text-sm"
                >
                  <span class="sigil">↗</span> {new URL(p.prod).host}
                </a>
              )}
              </div>
              {i === 0 && (
                <div class="project-system" aria-label={t["projects.architecture"]} data-i18n-attr="aria-label:projects.architecture">
                  <span class="project-system-caption" data-i18n="projects.architecture">{t["projects.architecture"]}</span>
                  <div class="system-node"><span data-i18n="projects.interface">{t["projects.interface"]}</span><strong>Nuxt / Vue</strong></div>
                  <div class="system-connector" aria-hidden="true">↓ ↑</div>
                  <div class="system-node"><span>API + realtime</span><strong>Strapi / Socket.io</strong></div>
                  <div class="system-connector" aria-hidden="true">↓ ↑</div>
                  <div class="system-node"><span data-i18n="projects.data">{t["projects.data"]}</span><strong>MySQL / AWS S3</strong></div>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ EXPERIENCE ============ -->
    <section
      id="experience"
      class="max-w-6xl mx-auto px-5 md:px-8 py-24 md:py-32 border-t border-[color-mix(in_srgb,var(--color-phosphor)_15%,transparent)]"
    >
      <SectionHeader
        cmd="cat experience.log"
        label={t["experience.label"]}
        labelKey="experience.label"
        heading={t["experience.heading"]}
        headingKey="experience.heading"
      />

      <div class="frame p-5 md:p-8 font-mono text-sm" data-label="tail -f">
        <div class="space-y-1.5">
          {
            experience.map((e, i) => (
              <details open={i === 0} class="experience-entry group border-b border-[color-mix(in_srgb,var(--color-phosphor)_15%,transparent)] last:border-b-0 py-2">
                <summary class="cursor-pointer list-none flex flex-wrap items-center gap-x-4 gap-y-1 md:grid md:grid-cols-[13rem_10rem_auto_1fr_auto] hover:bg-[color-mix(in_srgb,var(--color-phosphor)_5%,transparent)] -mx-2 px-2 py-1.5 rounded-sm">
                  <span class="text-[var(--color-muted)]" data-i18n={`exp-${e.id}-date`}>{t[`exp-${e.id}-date`] ?? e.date}</span>
                  <span class="text-[var(--color-phosphor)] w-40 truncate">
                    {e.host}
                  </span>
                  <span class="pill !text-[0.625rem]">[{e.role}]</span>
                  <span
                    class={`text-xs ${e.state === "ACTIVE" ? "text-[var(--color-amber)]" : "text-[var(--color-phosphor)]"}`}
                  >
                    {e.state}
                  </span>
                  <span class="ml-auto text-[var(--color-muted)] text-xs group-open:rotate-90 transition-transform">
                    ▸
                  </span>
                </summary>
                <div class="pl-2 md:pl-56 pt-3 pb-2 text-[var(--color-ink)]/90 space-y-2">
                  <div>
                    <span
                      class="text-[var(--color-amber)]"
                      data-i18n={`exp-${e.id}-title`}
                    >
                      {t[`exp-${e.id}-title`] ?? e.title}
                    </span>
                    <span class="text-[var(--color-muted)]">
                      {" "}
                      · {e.org} ·{" "}
                      <span data-i18n={`exp-${e.id}-mode`}>
                        {t[`exp-${e.id}-mode`] ?? e.mode}
                      </span>
                    </span>
                  </div>
                  <ul class="list-none space-y-1">
                    {e.bullets.map((b, bi) => (
                      <li class="flex gap-2 text-[0.8125rem]">
                        <span class="sigil shrink-0">—</span>
